{
  "name": "snovalang",
  "displayName": "Snovalang",
  "description": "Syntax highlighting, brackets and file icon for Snovalang (.snl) sources. Lives in the snl repository; no marketplace or third-party dependency.",
  "publisher": "snovalang",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/snovalang/snl" },
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "snovalang",
        "aliases": ["Snovalang", "snovalang", "snl"],
        "extensions": [".snl"],
        "configuration": "./language-configuration.json",
        "icon": { "light": "./icons/snl.svg", "dark": "./icons/snl.svg" }
      }
    ],
    "grammars": [
      {
        "language": "snovalang",
        "scopeName": "source.snovalang",
        "path": "./syntaxes/snovalang.tmLanguage.json"
      }
    ]
  }
}
