package bootstrap.fixture

import builtin.io.console
import builtin.runtime

struct Record {
    public var label: string
    public var items: int[]
}

struct Holder {
    public var current: Record
    public var history: string
}

func describe(position: int): string {
    if position % 2 == 0 { return "even" + "-" + "item" }
    return "odd" + "-" + "item"
}

func labelOf(item: Record): string {
    return item.label
}

func thirdOf(item: Record): int {
    return item.items[2]
}

func build(position: int): Record {
    var items = [position, position + 1]
    items.push(position + 2)
    return Record { label: describe(position) + "!", items: items }
}

// Native memory gate: every iteration allocates strings, arrays and
// objects and overwrites the previous ones. With ownership, peak memory
// must not depend on the iteration count (20000 per program argument).
func main(): int {
    let iterations = 20000 * Runtime.argumentCount()
    var box = Holder { current: build(0), history: "" }
    var total = 0
    var position = 0
    while position < iterations {
        let next = build(position)
        box.current = next
        box.history = labelOf(next)
        if labelOf(box.current) == "even-item!" { total = total + thirdOf(box.current) }
        var copy = [box.current, next]
        total = total + copy.len()
        position = position + 1
    }
    Console.printline(box.history)
    return total % 256
}
