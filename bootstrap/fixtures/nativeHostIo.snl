package bootstrap.fixture

import builtin.io.console
import builtin.runtime

struct pair {
    public var left: int
    public var right: string
}

// Native runtime I/O differential: bytes and text files, file existence,
// program arguments, negative numbers and composite values.
func main(): int {
    let bytesPath = "build/bootstrap/nativeHostIo.bin"
    write_bytes(bytesPath, [104, 105, 0, 255, 10])
    let bytes = read_bytes(bytesPath)
    Console.printline(bytes.len())
    Console.printline(bytes[3] + bytes[0])
    Console.printline(Runtime.fileExists(bytesPath))
    Console.printline(Runtime.fileExists("build/bootstrap/nativeHostIo.missing"))
    let textPath = "build/bootstrap/nativeHostIo.txt"
    Console.printline(Runtime.writeText(textPath, "line " + "one"))
    let text = Runtime.readText(textPath)
    Console.printline(text)
    Console.printline(text == "line one")
    Console.printline(Runtime.argumentCount())
    Console.printline(Runtime.argument(0) + "|" + Runtime.argument(1))
    Console.printline(1 << 63)
    Console.printline(-42 / 5)
    let first = pair { left: 3, right: "x" }
    let second = pair { left: 3, right: "y" }
    Console.printline(first == second)
    Console.printline([first] == [first])
    Console.printline(null)
    return bytes[1]
}
