package bootstrap.fixture

import builtin.io.console

struct Node {
    public var label: string
    public var children: Node[]
}

func attach(parent: Node, child: Node): unit {
    parent.children.push(child)
}

// A strong cycle could never reach zero owners, so the native runtime
// rejects the store that would create it (snovac memory-safety policy).
func main(): int {
    var root = Node { label: "root", children: [] }
    var leaf = Node { label: "leaf", children: [] }
    attach(root, leaf)
    Console.printline("tree ok")
    attach(leaf, root)
    Console.printline("unreachable")
    return 0
}
