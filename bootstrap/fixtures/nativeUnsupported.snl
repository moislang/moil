package bootstrap.fixture

// Pulsar launches lower to SnBC opcode 54 (SPAWN), which the native backend
// does not support; the compiler must fail with a diagnostic instead of
// emitting partial assembly. (Unit enum variants, opcode 42, are supported
// since the native enum/match slice.)
func work(): unit {
}

func main(): int {
    pulsar work()
    return 0
}
