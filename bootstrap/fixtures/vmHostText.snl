package bootstrap.fixture

import builtin.io.console
import builtin.runtime

func main(): int {
    let probe = Runtime.environment("SNOVA_FIXTURE_TEXT")
    Console.printline(probe == "probe")
    Console.printline(probe + "!" == "probe!")
    let written = Runtime.writeText("build/bootstrap/vmHostText.txt", probe)
    Console.printline(written)
    return Runtime.argumentCount()
}
