package mois.library

// Entry of an IntMap bucket chain, stored in the map's entry arena. `next`
// is an arena index (-1 at the end of the chain), so chains hold no object
// references and stay acyclic. Entries are accessed through static methods
// because the seed cannot call a method on an array element.
class MapEntry {
    public var key: int
    public var payload: int
    public var next: int

    public static method keyOf(entry: MapEntry): int {
        return entry.key
    }

    public static method payloadOf(entry: MapEntry): int {
        return entry.payload
    }

    public static method nextOf(entry: MapEntry): int {
        return entry.next
    }

    public static method replacePayload(entry: MapEntry, newPayload: int): unit {
        entry.payload = newPayload
    }
}
