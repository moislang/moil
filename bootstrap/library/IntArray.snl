package mois.library

// Growable integer array with random-access writes and removal at the end.
// The logical size is a field; cells past the size are kept and reused, so
// removing and appending again does not allocate. Instance API (ADR-0007,
// SPEC-0001 slice 3): create it with `IntArray(cells, 0)`; cells are reached
// through `readCell`/`assignCell`, which take the element as a typed
// parameter, because neither the seed nor `moil build` v0.3.0 can call a
// method on an array element or bind a class element to a local.
class IntArray {
    public var cells: IntCell[]
    public var size: int

    public method count(): int {
        return size
    }

    public method isEmpty(): bool {
        return size == 0
    }

    // Value at index; missing when the index is out of range.
    public method at(index: int, missing: int): int {
        if index < 0 || index >= size { return missing }
        return readCell(cells[index])
    }

    // Writes value at index; returns false when the index is out of range.
    public method put(index: int, newValue: int): bool {
        if index < 0 || index >= size { return false }
        assignCell(cells[index], newValue)
        return true
    }

    public method append(newValue: int): unit {
        if size < cells.len() {
            assignCell(cells[size], newValue)
        } else {
            cells.push(IntCell(newValue))
        }
        size = size + 1
    }

    // Removes and returns the last value; missing when empty.
    public method removeLast(missing: int): int {
        if size == 0 { return missing }
        size = size - 1
        return readCell(cells[size])
    }

    public method swap(first: int, second: int): unit {
        let firstValue = readCell(cells[first])
        assignCell(cells[first], readCell(cells[second]))
        assignCell(cells[second], firstValue)
    }

    // Copies the logical contents into a new plain array.
    public method values(): int[] {
        var result: int[] = []
        var index = 0
        while index < size {
            result.push(readCell(cells[index]))
            index = index + 1
        }
        return result
    }

    private method readCell(cell: IntCell): int {
        return cell.read()
    }

    private method assignCell(cell: IntCell, newValue: int): unit {
        cell.assign(newValue)
    }
}
