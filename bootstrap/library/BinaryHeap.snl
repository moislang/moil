package mois.library

// Binary min-heap of ints (priority queue). Element i has children 2i + 1
// and 2i + 2. Insert and removal are O(log n); peek is O(1).
class BinaryHeap {
    public var storage: IntArray

    public method count(): int {
        let store = storage
        return store.count()
    }

    public method isEmpty(): bool {
        let store = storage
        return store.isEmpty()
    }

    public method insert(newValue: int): unit {
        let store = storage
        store.append(newValue)
        siftUp(store.count() - 1)
    }

    // Smallest value without removing it; missing when empty.
    public method peekMinimum(missing: int): int {
        let store = storage
        return store.at(0, missing)
    }

    // Removes and returns the smallest value; missing when empty.
    public method removeMinimum(missing: int): int {
        let store = storage
        if store.isEmpty() { return missing }
        let minimum = store.at(0, missing)
        let last = store.removeLast(missing)
        if store.count() > 0 {
            store.put(0, last)
            siftDown(0)
        }
        return minimum
    }

    private method siftUp(start: int): unit {
        let store = storage
        var index = start
        var moving = true
        while moving && index > 0 {
            let parent = (index - 1) / 2
            if store.at(index, 0) < store.at(parent, 0) {
                store.swap(index, parent)
                index = parent
            } else {
                moving = false
            }
        }
    }

    private method siftDown(start: int): unit {
        let store = storage
        let size = store.count()
        var index = start
        var moving = true
        while moving {
            let left = 2 * index + 1
            let right = left + 1
            var smallest = index
            if left < size && store.at(left, 0) < store.at(smallest, 0) { smallest = left }
            if right < size && store.at(right, 0) < store.at(smallest, 0) { smallest = right }
            if smallest == index {
                moving = false
            } else {
                store.swap(index, smallest)
                index = smallest
            }
        }
    }
}
