package mois.library.collections.tree

// Binary search tree from int keys to int payloads over a node arena.
// Operations are O(height); the tree is not rebalanced, so sorted
// insertions degrade to a list. Keys are unique: inserting an existing key
// replaces its payload. This aggregate owns the node arena; construct it with
// `BinaryTree(emptyNodes, -1)`.
class BinaryTree {
    var nodes: TreeNode[]
    var rootIndex: int

    public method count(): int {
        return nodes.len()
    }

    public method isEmpty(): bool {
        return nodes.len() == 0
    }

    private method addNode(key: int, payload: int): int {
        nodes.push(TreeNode(key, payload, -1, -1))
        return nodes.len() - 1
    }

    // Arena index of key, or -1 when absent.
    public method indexOf(key: int): int {
        var index = rootIndex
        while index >= 0 {
            let nodeKey = readKey(nodes[index])
            if key == nodeKey { return index }
            if key < nodeKey {
                index = readLeft(nodes[index])
            } else {
                index = readRight(nodes[index])
            }
        }
        return -1
    }

    // Returns true when the key was not present before.
    public method insert(key: int, payload: int): bool {
        if rootIndex < 0 {
            rootIndex = addNode(key, payload)
            return true
        }
        var index = rootIndex
        while true {
            let nodeKey = readKey(nodes[index])
            if key == nodeKey {
                replaceValue(nodes[index], payload)
                return false
            }
            if key < nodeKey {
                let child = readLeft(nodes[index])
                if child < 0 {
                    linkLeft(nodes[index], addNode(key, payload))
                    return true
                }
                index = child
            } else {
                let child = readRight(nodes[index])
                if child < 0 {
                    linkRight(nodes[index], addNode(key, payload))
                    return true
                }
                index = child
            }
        }
        return false
    }

    // Payload of key, or missing when absent.
    public method find(key: int, missing: int): int {
        let index = indexOf(key)
        if index < 0 { return missing }
        return readValue(nodes[index])
    }

    public method contains(key: int): bool {
        return indexOf(key) >= 0
    }

    public method minimumKey(missing: int): int {
        if rootIndex < 0 { return missing }
        var index = rootIndex
        while readLeft(nodes[index]) >= 0 {
            index = readLeft(nodes[index])
        }
        return readKey(nodes[index])
    }

    public method maximumKey(missing: int): int {
        if rootIndex < 0 { return missing }
        var index = rootIndex
        while readRight(nodes[index]) >= 0 {
            index = readRight(nodes[index])
        }
        return readKey(nodes[index])
    }

    private method heightAt(index: int): int {
        if index < 0 { return 0 }
        let leftHeight = heightAt(readLeft(nodes[index]))
        let rightHeight = heightAt(readRight(nodes[index]))
        if leftHeight > rightHeight { return leftHeight + 1 }
        return rightHeight + 1
    }

    public method height(): int {
        return heightAt(rootIndex)
    }

    private method collectFrom(index: int, result: int[]): unit {
        if index < 0 { return }
        collectFrom(readLeft(nodes[index]), result)
        result.push(readKey(nodes[index]))
        collectFrom(readRight(nodes[index]), result)
    }

    // Keys in ascending order.
    public method keys(): int[] {
        var result: int[] = []
        collectFrom(rootIndex, result)
        return result
    }

    // The root compiler cannot call a method directly on an array element.
    // These helpers keep the entity behavior on TreeNode while the aggregate
    // passes the selected entity as a typed collaborator.
    private method readKey(node: TreeNode): int { return node.readKey() }
    private method readValue(node: TreeNode): int { return node.readValue() }
    private method readLeft(node: TreeNode): int { return node.readLeftIndex() }
    private method readRight(node: TreeNode): int { return node.readRightIndex() }
    private method replaceValue(node: TreeNode, value: int): unit { node.replaceValue(value) }
    private method linkLeft(node: TreeNode, child: int): unit { node.linkLeft(child) }
    private method linkRight(node: TreeNode, child: int): unit { node.linkRight(child) }
}
