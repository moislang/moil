package mois.library.algorithms.search

// Searches over int arrays sorted in ascending order. Stateless instance
// API (ADR-0007): create it with `BinarySearch()`, so code built by
// `moil build` v0.3.0 can use it.
class BinarySearch {
    // First index whose value is >= target; values.len() when none is.
    public method lowerBound(values: int[], target: int): int {
        var low = 0
        var high = values.len()
        while low < high {
            let middle = low + (high - low) / 2
            if values[middle] < target {
                low = middle + 1
            } else {
                high = middle
            }
        }
        return low
    }

    // First index whose value is > target; values.len() when none is.
    public method upperBound(values: int[], target: int): int {
        var low = 0
        var high = values.len()
        while low < high {
            let middle = low + (high - low) / 2
            if values[middle] <= target {
                low = middle + 1
            } else {
                high = middle
            }
        }
        return low
    }

    // Index of target, or -1 when it is absent.
    public method indexOf(values: int[], target: int): int {
        let index = lowerBound(values, target)
        if index < values.len() && values[index] == target { return index }
        return -1
    }

    public method contains(values: int[], target: int): bool {
        return indexOf(values, target) >= 0
    }
}
