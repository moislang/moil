package mois.library

// Mutable integer cell. The seed subset has no index assignment, so mutable
// indexed storage is an array of cells whose field changes. Instance API
// (ADR-0007, SPEC-0001 slice 3): create a cell with `IntCell(value)`. Neither
// the seed nor `moil build` v0.3.0 can call a method on an array element, so
// owners pass the element to a sibling method that takes the cell as a typed
// parameter and calls `read`/`assign` on it.
class IntCell {
    public var value: int

    public method assign(newValue: int): unit {
        value = newValue
    }

    public method read(): int {
        return value
    }
}
