package mois.compiler.backend

// Assembly at the OS/ABI boundary (ADR-0003, ADR-0006): process entry, stubs
// for the native methods of Primitive and System, the stack overflow
// routine, string constants and the state block. This is the only generated
// code that calls libSystem.
class NativeBoundary {
    // Stub for native role 0..13. On entry argument i of n is at
    // [sp + 16 * (n - 1 - i)]; system stubs build a frame first, so the same
    // argument is at [x29 + 16 + 16 * (n - 1 - i)].
    public method nativeStub(output: NativeAssembly, functionIndex: int, role: int, symbolPrefix: string, targetKind: int): unit {
        output.directive(".p2align 2")
        output.label(output.symbol(functionIndex))
        if role == 0 {
            output.stateAddress("x0")
            output.line("mov x1, #1")
        } else if role == 1 || role == 3 {
            output.line("ldr x9, [sp]")
            if role == 1 { output.line("ldr x0, [x9]") } else { output.line("ldrb w0, [x9]") }
            output.line("mov x1, #1")
        } else if role == 2 || role == 4 {
            output.line("ldr x9, [sp, #16]")
            output.line("ldr x10, [sp]")
            if role == 2 { output.line("str x10, [x9]") } else { output.line("strb w10, [x9]") }
            output.line("mov x0, #0")
            output.line("mov x1, #0")
        } else if role == 5 {
            output.line("ldr x1, [sp, #16]")
            output.line("ldr x0, [sp]")
        } else {
            if targetKind == 3 { linuxSystemStub(output, role) } else { systemStub(output, role, symbolPrefix) }
            return
        }
        output.line("ret")
    }

    // Linux AArch64 uses the kernel syscall ABI directly. Kernel errors are
    // negative errno values; the runtime consistently treats any negative
    // result as failure.
    private method linuxSystemStub(output: NativeAssembly, role: int): unit {
        output.line("stp x29, x30, [sp, #-16]!")
        output.line("mov x29, sp")
        if role == 6 || role == 7 {
            output.line("ldr x0, [x29, #48]")
            output.line("ldr x1, [x29, #32]")
            output.line("ldr x2, [x29, #16]")
            if role == 6 { output.line("mov x8, #64") } else { output.line("mov x8, #63") }
            output.line("svc #0")
        }
        if role == 8 {
            output.line("mov x0, #-100")
            output.line("ldr x1, [x29, #48]")
            output.line("ldr x2, [x29, #32]")
            // The Mois Host runtime uses Darwin's O_CREAT/O_TRUNC bit values
            // (1537). Translate its single write mode to Linux O_* values.
            let flagsReady = output.newLabel()
            output.line("cmp x2, #1537")
            output.line("b.ne " + flagsReady)
            output.line("mov x2, #577")
            output.label(flagsReady)
            output.line("ldr x3, [x29, #16]")
            output.line("mov x8, #56")
            output.line("svc #0")
        }
        if role == 9 {
            output.line("ldr x0, [x29, #16]")
            output.line("mov x8, #57")
            output.line("svc #0")
        }
        if role == 10 {
            output.line("mov x0, #0")
            output.line("ldr x1, [x29, #16]")
            output.line("mov x2, #3")
            output.line("mov x3, #34")
            output.line("mov x4, #-1")
            output.line("mov x5, #0")
            output.line("mov x8, #222")
            output.line("svc #0")
        }
        if role == 11 {
            output.line("ldr x0, [x29, #32]")
            output.line("ldr x1, [x29, #16]")
            output.line("mov x8, #215")
            output.line("svc #0")
        }
        if role == 12 {
            output.line("ldr x0, [x29, #16]")
            output.line("mov x8, #94")
            output.line("svc #0")
        }
        if role == 13 {
            // getdents64(descriptor, buffer, length) for read_dir (ADR-0011).
            output.line("ldr x0, [x29, #48]")
            output.line("ldr x1, [x29, #32]")
            output.line("ldr x2, [x29, #16]")
            output.line("mov x8, #61")
            output.line("svc #0")
        }
        output.line("mov x1, #1")
        output.line("ldp x29, x30, [sp], #16")
        output.line("ret")
    }

    private method systemStub(output: NativeAssembly, role: int, symbolPrefix: string): unit {
        output.line("stp x29, x30, [sp, #-16]!")
        output.line("mov x29, sp")
        if role == 6 || role == 7 || role == 8 {
            output.line("ldr x0, [x29, #48]")
            output.line("ldr x1, [x29, #32]")
            output.line("ldr x2, [x29, #16]")
        }
        if role == 6 { output.line("bl " + symbolPrefix + "write") }
        if role == 7 { output.line("bl " + symbolPrefix + "read") }
        if role == 8 {
            // open is variadic: on Darwin arm64 the mode goes on the stack.
            output.line("sub sp, sp, #16")
            output.line("str x2, [sp]")
            output.line("bl " + symbolPrefix + "open")
            output.line("add sp, sp, #16")
            output.line("sxtw x0, w0")
        }
        if role == 9 {
            output.line("ldr x0, [x29, #16]")
            output.line("bl " + symbolPrefix + "close")
            output.line("sxtw x0, w0")
        }
        if role == 10 {
            // mmap(0, length, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANON, -1, 0)
            output.line("ldr x1, [x29, #16]")
            output.line("mov x0, #0")
            output.line("mov x2, #3")
            output.line("mov x3, #4098")
            output.line("mov x4, #-1")
            output.line("mov x5, #0")
            output.line("bl " + symbolPrefix + "mmap")
        }
        if role == 11 {
            output.line("ldr x0, [x29, #32]")
            output.line("ldr x1, [x29, #16]")
            output.line("bl " + symbolPrefix + "munmap")
            output.line("sxtw x0, w0")
        }
        if role == 12 {
            output.line("ldr x0, [x29, #16]")
            output.line("bl " + symbolPrefix + "exit")
        }
        if role == 13 {
            // Darwin listing is not implemented yet (ADR-0011): -ENOSYS makes
            // read_dir answer status 2.
            output.line("mov x0, #-38")
        }
        output.line("mov x1, #1")
        output.line("ldp x29, x30, [sp], #16")
        output.line("ret")
    }

    // _main stores argc, argv and envp in the state block, runs the
    // program's main and passes its int result (0 for any other tag, as the
    // executor) to Runtime.finish, which reports live memory on request and
    // exits.
    public method entry(output: NativeAssembly, mainFunction: int, symbolPrefix: string, textSection: string, targetKind: int): unit {
        output.directive(textSection)
        if targetKind == 3 {
            output.directive(".globl _start")
            output.label("_start")
            output.line("ldr x0, [sp]")
            output.line("add x1, sp, #8")
            output.line("add x2, x1, x0, lsl #3")
            output.line("add x2, x2, #8")
            output.line("bl main")
        }
        output.directive(".globl " + symbolPrefix + "main")
        output.directive(".p2align 2")
        output.label(symbolPrefix + "main")
        output.line("stp x29, x30, [sp, #-16]!")
        output.line("mov x29, sp")
        output.stateAddress("x9")
        output.line("stp x0, x1, [x9]")
        output.line("str x2, [x9, #16]")
        output.line("bl " + output.symbol(mainFunction))
        output.line("cmp x1, #1")
        output.line("csel x0, x0, xzr, eq")
        output.beginArguments()
        output.pushInteger("x0")
        output.callRole(output.roleFinish(), 1)
        output.directive(".p2align 2")
        output.label("Lmois_stack_overflow")
        output.callFail(3, 0)
    }

    // String constants in the runtime string layout [length][bytes], after a
    // header whose negative owner count marks them as never counted or
    // freed; then the zeroed state block.
    public method data(output: NativeAssembly, image: NativeImage, constSection: string, bssSection: string, targetKind: int): unit {
        output.directive(constSection)
        var offset = 16
        var poolIndex = 0
        while poolIndex < image.poolCount() {
            let size = image.u32(offset)
            output.directive(".p2align 3")
            output.line(".quad -1")
            output.line(".quad 0")
            output.label("l_mois_pool_" + output.decimal(poolIndex))
            output.line(".quad " + output.decimal(size))
            var index = 0
            while index < size {
                var text = ".byte " + output.decimal(image.byteAt(offset + 4 + index))
                var column = 1
                while column < 16 && index + column < size {
                    text = text + ", " + output.decimal(image.byteAt(offset + 4 + index + column))
                    column = column + 1
                }
                output.line(text)
                index = index + column
            }
            offset = offset + 4 + size
            poolIndex = poolIndex + 1
        }
        output.directive(bssSection)
        if targetKind == 3 {
            output.directive(".balign 16")
            output.directive(".globl mois_state")
            output.label("mois_state")
            output.directive(".zero 256")
        }
    }
}
