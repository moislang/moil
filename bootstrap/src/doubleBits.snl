package snova.compiler.runtime

// IEEE 754 binary64 values as 64-bit patterns held in ints. The transitional
// root (`snl build` v0.3.0) does not run double arithmetic correctly on the
// linux-x86_64 host (evidence.md), so the compiler and the SnBC executor
// never use host doubles: literals are converted here with integer
// arithmetic, and printing uses the exact decimal expansion of the pattern.
//
// Big numbers are int[] of base 1e9 limbs, least significant first. The
// seed subset has no index assignment, so every operation returns a new
// array.
class DoubleParts {
    // 0 zero, 1 finite, 2 infinity, 3 NaN
    public var kind: int
    public var negative: int
    // six significant digits, 100000..999999 for finite values
    public var digits: int
    // decimal exponent of the first significant digit
    public var exponent: int
}

class DoubleBits {
    // 1 after parse when the literal is outside the normal range
    public var failed: int

    public method limb(): int { return 1000000000 }

    public method big(value: int): int[] {
        var result: int[] = []
        var rest = value
        result.push(rest % limb())
        rest = rest / limb()
        while rest > 0 {
            result.push(rest % limb())
            rest = rest / limb()
        }
        return result
    }

    // factor < 2^31, so limb * factor + carry stays below 2^62.
    public method times(value: int[], factor: int): int[] {
        var result: int[] = []
        var carry = 0
        var index = 0
        while index < value.len() {
            let product = value[index] * factor + carry
            result.push(product % limb())
            carry = product / limb()
            index = index + 1
        }
        while carry > 0 {
            result.push(carry % limb())
            carry = carry / limb()
        }
        return result
    }

    public method timesPower(value: int[], base: int, count: int): int[] {
        var result = times(value, 1)
        var left = count
        var step = 1
        var stepCount = 0
        while step * base < 1073741824 {
            step = step * base
            stepCount = stepCount + 1
        }
        while left >= stepCount {
            result = times(result, step)
            left = left - stepCount
        }
        while left > 0 {
            result = times(result, base)
            left = left - 1
        }
        return result
    }

    // Length without high zero limbs.
    public method used(value: int[]): int {
        var length = value.len()
        while length > 1 && value[length - 1] == 0 { length = length - 1 }
        return length
    }

    public method isZero(value: int[]): int {
        if used(value) == 1 && value[0] == 0 { return 1 }
        return 0
    }

    // -1, 0 or 1.
    public method compare(left: int[], right: int[]): int {
        let leftLength = used(left)
        let rightLength = used(right)
        if leftLength != rightLength {
            if leftLength < rightLength { return -1 }
            return 1
        }
        var index = leftLength - 1
        while index >= 0 {
            if left[index] != right[index] {
                if left[index] < right[index] { return -1 }
                return 1
            }
            index = index - 1
        }
        return 0
    }

    // left - right for left >= right.
    public method minus(left: int[], right: int[]): int[] {
        var result: int[] = []
        var borrow = 0
        var index = 0
        while index < left.len() {
            var value = left[index] - borrow
            if index < right.len() { value = value - right[index] }
            borrow = 0
            if value < 0 {
                value = value + limb()
                borrow = 1
            }
            result.push(value)
            index = index + 1
        }
        return result
    }

    // value / 2 for an even value.
    public method half(value: int[]): int[] {
        var reversed: int[] = []
        var remainder = 0
        var index = value.len() - 1
        while index >= 0 {
            let current = remainder * limb() + value[index]
            reversed.push(current / 2)
            remainder = current % 2
            index = index - 1
        }
        var result: int[] = []
        index = reversed.len() - 1
        while index >= 0 {
            result.push(reversed[index])
            index = index - 1
        }
        return result
    }

    // floor(numerator / denominator) for a quotient below 2^58; whether the
    // remainder is nonzero goes to sticky.kind.
    public method quotient(numerator: int[], denominator: int[], sticky: DoubleParts): int {
        var multiple = timesPower(denominator, 2, 57)
        var rest = numerator
        var result = 0
        var bit = 57
        while bit >= 0 {
            result = result * 2
            if compare(rest, multiple) >= 0 {
                rest = minus(rest, multiple)
                result = result + 1
            }
            if bit > 0 { multiple = half(multiple) }
            bit = bit - 1
        }
        sticky.kind = 1 - isZero(rest)
        return result
    }

    public method decimalLength(value: int[]): int {
        let length = used(value)
        var top = value[length - 1]
        var count = 9 * (length - 1)
        while top > 0 {
            count = count + 1
            top = top / 10
        }
        return count
    }

    // Pattern of significand * 10^exponent10, rounded to nearest-even.
    // Literals that round to a subnormal or overflow set failed.
    public method parse(significand: int[], exponent10: int): int {
        failed = 0
        var numerator = big(0)
        var index = 0
        while index < significand.len() {
            numerator = addSmall(times(numerator, 10), significand[index])
            index = index + 1
        }
        if isZero(numerator) == 1 { return 0 }
        if exponent10 > 400 || exponent10 < -400 {
            failed = 1
            return 0
        }
        var denominator = big(1)
        if exponent10 >= 0 {
            numerator = timesPower(numerator, 10, exponent10)
        } else {
            denominator = timesPower(denominator, 10, 0 - exponent10)
        }
        // log2(10) is about 3.32: start near the scale that puts the
        // quotient in [2^53, 2^54), then correct by single steps.
        var scale = 53 - ((decimalLength(numerator) - decimalLength(denominator)) * 332) / 100
        var parts = DoubleParts(0, 0, 0, 0)
        var value = 0
        var go = 1
        while go == 1 {
            var scaledNumerator = timesPower(numerator, 2, 0)
            var scaledDenominator = timesPower(denominator, 2, 0)
            if scale >= 0 {
                scaledNumerator = timesPower(numerator, 2, scale)
            } else {
                scaledDenominator = timesPower(denominator, 2, 0 - scale)
            }
            if compare(scaledNumerator, timesPower(scaledDenominator, 2, 58)) >= 0 {
                scale = scale - 4
            } else {
                value = quotient(scaledNumerator, scaledDenominator, parts)
                if value >= (1 << 54) {
                    scale = scale - 1
                } else if value < (1 << 53) {
                    scale = scale + 1
                } else {
                    go = 0
                }
            }
        }
        var mantissa = value / 2
        let guard = value % 2
        if guard == 1 && (parts.kind == 1 || mantissa % 2 == 1) { mantissa = mantissa + 1 }
        var biased = 1076 - scale
        if mantissa == (1 << 53) {
            mantissa = mantissa / 2
            biased = biased + 1
        }
        if biased >= 2047 || biased <= 0 {
            failed = 1
            return 0
        }
        return biased * (1 << 52) + (mantissa - (1 << 52))
    }

    public method addSmall(value: int[], amount: int): int[] {
        var result: int[] = []
        var carry = amount
        var index = 0
        while index < value.len() {
            let sum = value[index] + carry
            result.push(sum % limb())
            carry = sum / limb()
            index = index + 1
        }
        if carry > 0 { result.push(carry) }
        return result
    }

    // Decimal digit at position (0 = most significant) of a big number with
    // `length` decimal digits; 0 past the end.
    public method digitAt(value: int[], length: int, position: int): int {
        if position >= length { return 0 }
        let fromLow = length - 1 - position
        var part = value[fromLow / 9]
        var skip = fromLow % 9
        while skip > 0 {
            part = part / 10
            skip = skip - 1
        }
        return part % 10
    }

    // %g with precision 6: the six correctly rounded significant digits of
    // the exact value, ties to even, as glibc printf does.
    public method decompose(bits: int, parts: DoubleParts): unit {
        var magnitude = bits
        parts.negative = 0
        if bits < 0 {
            parts.negative = 1
            magnitude = bits + (1 << 62) + (1 << 62)
        }
        let biased = magnitude / (1 << 52)
        let fraction = magnitude % (1 << 52)
        parts.digits = 0
        parts.exponent = 0
        if biased == 2047 {
            if fraction == 0 { parts.kind = 2 } else { parts.kind = 3 }
            return
        }
        if biased == 0 && fraction == 0 {
            parts.kind = 0
            return
        }
        parts.kind = 1
        var mantissa = fraction
        var exponent2 = -1074
        if biased > 0 {
            mantissa = fraction + (1 << 52)
            exponent2 = biased - 1075
        }
        var exact = big(mantissa)
        var pointShift = 0
        if exponent2 >= 0 {
            exact = timesPower(exact, 2, exponent2)
        } else {
            exact = timesPower(exact, 5, 0 - exponent2)
            pointShift = 0 - exponent2
        }
        let length = decimalLength(exact)
        var digits = 0
        var position = 0
        while position < 6 {
            digits = digits * 10 + digitAt(exact, length, position)
            position = position + 1
        }
        let next = digitAt(exact, length, 6)
        var restNonzero = 0
        position = 7
        while position < length && restNonzero == 0 {
            if digitAt(exact, length, position) != 0 { restNonzero = 1 }
            position = position + 1
        }
        var exponent = length - pointShift - 1
        if next > 5 || next == 5 && (restNonzero == 1 || digits % 2 == 1) {
            digits = digits + 1
            if digits == 1000000 {
                digits = 100000
                exponent = exponent + 1
            }
        }
        parts.digits = digits
        parts.exponent = exponent
    }
}
