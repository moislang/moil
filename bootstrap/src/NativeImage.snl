package mois.compiler.backend

// Read-only view of a validated SnBC image: header, string pool and
// function table (layout written by Compiler.snl writeImage).
class NativeImage {
    public var bytes: int[]
    public var poolOffsets: int[]
    public var functionOffset: int

    public method byteAt(offset: int): int {
        return bytes[offset]
    }

    public method u32(offset: int): int {
        return bytes[offset] + bytes[offset + 1] * 256 +
            bytes[offset + 2] * 65536 + bytes[offset + 3] * 16777216
    }

    public method signed32(offset: int): int {
        let value = u32(offset)
        if value >= 2147483648 { return value - 4294967296 }
        return value
    }

    public method mainFunction(): int {
        return u32(8)
    }

    public method poolCount(): int {
        return u32(12)
    }

    // Offset of the function table, after the string pool.
    public method functionTable(): int {
        return functionOffset
    }

    public method indexPool(): unit {
        var offset = 16
        var poolIndex = 0
        while poolIndex < poolCount() {
            poolOffsets.push(offset)
            offset = offset + 4 + u32(offset)
            poolIndex = poolIndex + 1
        }
        functionOffset = offset
    }

    private method poolEntry(index: int): int {
        return poolOffsets[index]
    }

    private method poolStringLength(index: int): int {
        return u32(poolEntry(index))
    }

    public method poolBytes(index: int): int[] {
        let entry = poolEntry(index)
        let length = u32(entry)
        var result: int[] = []
        var position = 0
        while position < length {
            result.push(bytes[entry + 4 + position])
            position = position + 1
        }
        return result
    }

    private method appendBytes(target: int[], source: int[]): unit {
        var position = 0
        while position < source.len() {
            target.push(source[position])
            position = position + 1
        }
    }

    private method qualifiedName(typeIndex: int, methodIndex: int): int[] {
        var result: int[] = []
        appendBytes(result, poolBytes(typeIndex))
        result.push(46)
        appendBytes(result, poolBytes(methodIndex))
        return result
    }

    private method matchesName(expected: int[], start: int, length: int): bool {
        if expected.len() != length { return false }
        var position = 0
        while position < length {
            if expected[position] != bytes[start + position] { return false }
            position = position + 1
        }
        return true
    }

    // Resolve a concrete `Type.method` from the image's string pool. This
    // runs during code generation; generated native dispatch itself is O(1).
    public method findMethod(typeIndex: int, methodIndex: int): int {
        let expected = qualifiedName(typeIndex, methodIndex)
        var offset = functionTable()
        let functionCount = u32(offset)
        offset = offset + 4
        var functionIndex = 0
        while functionIndex < functionCount {
            let nameLength = u32(offset)
            let nameStart = offset + 4
            if matchesName(expected, nameStart, nameLength) { return functionIndex }
            offset = nameStart + nameLength
            offset = offset + 12 + u32(offset + 8)
            functionIndex = functionIndex + 1
        }
        return -1
    }

    public method operandWidth(opcode: int): int {
        if opcode == 1 || opcode == 2 || opcode == 33 || opcode == 34 || opcode == 36 || opcode == 42 ||
            opcode == 53 || opcode == 54 || opcode == 55 || opcode == 57 || opcode == 59 { return 8 }
        if opcode == 3 || opcode == 8 || opcode == 9 || opcode == 10 || opcode == 11 ||
            opcode == 30 || opcode == 31 || opcode == 32 || opcode == 37 || opcode == 38 ||
            opcode == 39 || opcode == 43 || opcode == 44 { return 4 }
        if opcode == 4 || opcode == 45 { return 1 }
        return 0
    }
}
