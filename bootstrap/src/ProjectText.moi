package mois.compiler.project

import builtin.runtime
import mois.compiler.runtime

// Byte strings for the project resolver (SPEC-0003). Host strings in the
// compiler subset have no byte access and identity-only equality, so names
// and paths are int[] bytes, and conversions to host strings go through a
// scratch file, like the SnBC executor (ADR-0004).
class ProjectText {
    public method scratchPath(): string {
        var directory = Runtime.environment("TEMP")
        if directory == "" { directory = Runtime.environment("TMP") }
        if directory == "" { directory = Runtime.environment("TMPDIR") }
        if directory == "" { directory = "/tmp" }
        return directory + "/mois-project.bin"
    }

    public method text(bytes: int[]): string {
        let path = scratchPath()
        write_bytes(path, bytes)
        return Runtime.readText(path)
    }

    public method bytesOf(value: string): int[] {
        let path = scratchPath()
        Runtime.writeText(path, value)
        return read_bytes(path)
    }

    // `value == false` is unreliable in `moil` v0.3.0 for bools returned by
    // calls or read from fields (evidence.md, root bool comparison probe);
    // truthiness, `&&` and `||` are reliable, so negation branches.
    public method negate(value: bool): bool {
        if value { return 0 == 1 }
        return 0 == 0
    }

    public method slice(bytes: int[], start: int, count: int): int[] {
        var out: int[] = []
        var index = 0
        while index < count {
            out.push(bytes[start + index])
            index = index + 1
        }
        return out
    }

    public method appendBytes(target: int[], source: int[]): unit {
        var index = 0
        while index < source.len() {
            target.push(source[index])
            index = index + 1
        }
    }

    public method same(left: int[], right: int[]): bool {
        return compareRange(left, 0, left.len(), right, 0, right.len()) == 0
    }

    // Byte order: negative, zero or positive.
    public method compareRange(left: int[], leftStart: int, leftCount: int, right: int[], rightStart: int, rightCount: int): int {
        var index = 0
        while index < leftCount && index < rightCount {
            let difference = left[leftStart + index] - right[rightStart + index]
            if difference != 0 { return difference }
            index = index + 1
        }
        return leftCount - rightCount
    }

    public method startsWith(bytes: int[], prefix: int[]): bool {
        if prefix.len() > bytes.len() { return false }
        return compareRange(bytes, 0, prefix.len(), prefix, 0, prefix.len()) == 0
    }

    public method endsWith(bytes: int[], suffix: int[]): bool {
        if suffix.len() > bytes.len() { return false }
        return compareRange(bytes, bytes.len() - suffix.len(), suffix.len(), suffix, 0, suffix.len()) == 0
    }

    public method isSpace(code: int): bool {
        return code == 32 || code == 9 || code == 10 || code == 13
    }

    public method isIdentifier(bytes: int[], start: int, count: int): bool {
        if count == 0 { return false }
        var index = 0
        while index < count {
            let code = bytes[start + index]
            let letter = (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
            let digit = code >= 48 && code <= 57
            if negate(letter) && (negate(digit) || index == 0) { return false }
            index = index + 1
        }
        return true
    }

    // Identifiers separated by single dots: `com.example.models`.
    public method isQualifiedName(bytes: int[]): bool {
        var start = 0
        var index = 0
        while index <= bytes.len() {
            if index == bytes.len() || bytes[index] == 46 {
                if negate(isIdentifier(bytes, start, index - start)) { return false }
                start = index + 1
            }
            index = index + 1
        }
        return true
    }

    public method segmentCount(name: int[]): int {
        if name.len() == 0 { return 0 }
        var count = 1
        var index = 0
        while index < name.len() {
            if name[index] == 46 { count = count + 1 }
            index = index + 1
        }
        return count
    }

    // Segment `which` (0-based) of a dotted name.
    public method segment(name: int[], which: int): int[] {
        var start = 0
        var current = 0
        var index = 0
        while index <= name.len() {
            if index == name.len() || name[index] == 46 {
                if current == which { return slice(name, start, index - start) }
                current = current + 1
                start = index + 1
            }
            index = index + 1
        }
        var none: int[] = []
        return none
    }

    // True when `name` is `root` or lies under it (`root.` prefix).
    public method underPackage(name: int[], root: int[]): bool {
        if negate(startsWith(name, root)) { return false }
        if name.len() == root.len() { return true }
        return name[root.len()] == 46
    }

    // `name` without `root.`; empty when they are equal.
    public method relativeName(name: int[], root: int[]): int[] {
        if name.len() == root.len() {
            var none: int[] = []
            return none
        }
        return slice(name, root.len() + 1, name.len() - root.len() - 1)
    }

    // Dots become slashes: `models.entities` -> `models/entities`.
    public method folderPath(name: int[]): int[] {
        var out: int[] = []
        var index = 0
        while index < name.len() {
            if name[index] == 46 { out.push(47) } else { out.push(name[index]) }
            index = index + 1
        }
        return out
    }

    public method dottedJoin(left: int[], right: int[]): int[] {
        var out: int[] = []
        appendBytes(out, left)
        if left.len() > 0 && right.len() > 0 { out.push(46) }
        appendBytes(out, right)
        return out
    }

    // Normalized path: `\` becomes `/`, leading `./` and trailing `/` go.
    public method normalPath(path: int[]): int[] {
        var out: int[] = []
        var index = 0
        while index + 1 < path.len() && path[index] == 46 && (path[index + 1] == 47 || path[index + 1] == 92) {
            index = index + 2
        }
        while index < path.len() {
            if path[index] == 92 { out.push(47) } else { out.push(path[index]) }
            index = index + 1
        }
        if out.len() == 0 { out.push(46) }
        return trimmedSlash(out)
    }

    private method trimmedSlash(path: int[]): int[] {
        var count = path.len()
        while count > 1 && path[count - 1] == 47 { count = count - 1 }
        return slice(path, 0, count)
    }

    public method joinPath(directory: int[], name: int[]): int[] {
        if directory.len() == 1 && directory[0] == 46 { return slice(name, 0, name.len()) }
        var out: int[] = []
        appendBytes(out, directory)
        if directory[directory.len() - 1] != 47 { out.push(47) }
        appendBytes(out, name)
        return out
    }

    public method lastSlash(path: int[]): int {
        var index = path.len() - 1
        while index >= 0 {
            if path[index] == 47 { return index }
            index = index - 1
        }
        return -1
    }

    public method directoryOf(path: int[]): int[] {
        let slash = lastSlash(path)
        if slash < 0 { return [46] }
        if slash == 0 { return [47] }
        return slice(path, 0, slash)
    }

    public method lastName(path: int[]): int[] {
        let slash = lastSlash(path)
        return slice(path, slash + 1, path.len() - slash - 1)
    }

    // True when the folder name of `directory` is unknown from the text of
    // the path (`.`, `..`, `/`): the resolver cannot check or strip it.
    public method opaqueDirectory(directory: int[]): bool {
        let name = lastName(directory)
        if name.len() == 0 { return true }
        if name.len() == 1 && name[0] == 46 { return true }
        return name.len() == 2 && name[0] == 46 && name[1] == 46
    }

    public method moiSuffix(): int[] {
        return [46, 109, 111, 105]
    }

    public method propertiesName(): int[] {
        // moislang.properties
        return [109, 111, 105, 115, 108, 97, 110, 103, 46, 112, 114, 111, 112, 101, 114, 116, 105, 101, 115]
    }

    public method builtinPrefix(): int[] {
        return [98, 117, 105, 108, 116, 105, 110, 46]
    }

    public method fileExists(path: int[]): bool {
        return Runtime.fileExists(text(path))
    }

    public method readFile(path: int[]): int[] {
        return read_bytes(text(path))
    }

    // Host listing (RUNTIME_CALL 9): [status, (kind, name bytes, 0)*].
    public method listing(directory: int[]): int[] {
        return read_dir(text(directory))
    }
}
