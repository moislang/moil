package snova.compiler

func scopeCur(bg: compilerState, which: int): int {
    var n = bg.lp_id.len()
    if n == 0 { return 0 }
    if which == 0 { return bg.lp_id[n - 1] }
    if which == 1 { return bg.lp_known[n - 1] }
    return bg.lp_pos[n - 1]
}

func scopeLoopEnter(bg: compilerState, cx: compilerContext, pos: int, known: int): unit {
    bg.lp_id.push(cx.seq)
    bg.lp_known.push(known)
    bg.lp_pos.push(pos)
    cx.seq = cx.seq + 1
}

func scopeLoopLeave(bg: compilerState): unit {
    var ids: int[] = []
    var ks: int[] = []
    var ps: int[] = []
    var i = 0
    while i + 1 < bg.lp_id.len() {
        ids.push(bg.lp_id[i])
        ks.push(bg.lp_known[i])
        ps.push(bg.lp_pos[i])
        i = i + 1
    }
    bg.lp_id = ids
    bg.lp_known = ks
    bg.lp_pos = ps
}

func scopePatchTagged(code: int[], fat: int[], fb: int[], at: int[], lv: int[], id: int): unit {
    var i = 0
    while i < lv.len() {
        if lv[i] == id { patchAt(code, fat, fb, at[i]) }
        i = i + 1
    }
}

func scopePatchBrk(code: int[], fat: int[], fb: int[], bg: compilerState): unit {
    scopePatchTagged(code, fat, fb, bg.brk_at, bg.brk_lv, scopeCur(bg, 0))
}

func scopePatchCont(code: int[], fat: int[], fb: int[], bg: compilerState): unit {
    scopePatchTagged(code, fat, fb, bg.cont_at, bg.cont_lv, scopeCur(bg, 0))
}

func scopeEmitBreak(bg: compilerState, cx: compilerContext, code: int[]): unit {
    if bg.lp_id.len() == 0 {
        fail(cx)
        return
    }
    let at = emitJump(code, 30)
    bg.brk_at.push(at)
    bg.brk_lv.push(scopeCur(bg, 0))
}

func scopeEmitContinue(bg: compilerState, cx: compilerContext, code: int[]): unit {
    if bg.lp_id.len() == 0 {
        fail(cx)
        return
    }
    if scopeCur(bg, 1) == 1 {
        code.push(30)
        let at = code.len()
        let off = scopeCur(bg, 2) - (at + 4)
        pushU32(code, off)
        return
    }
    let at = emitJump(code, 30)
    bg.cont_at.push(at)
    bg.cont_lv.push(scopeCur(bg, 0))
}

func scopeFindMethod(src: int[], bg: compilerState, owner: int, s: int, n: int): int {
    var i = 0
    while i < bg.fn_ns.len() {
        if bg.fn_own[i] == owner {
            if spanEq(src, bg.fn_ns[i], bg.fn_nl[i], s, n) { return i }
        }
        i = i + 1
    }
    return -1
}

func scopeFieldIndex(src: int[], bg: compilerState, st: int, s: int, n: int): int {
    var i = 0
    var seen = 0
    var found = -1
    while i < bg.fd_st.len() {
        if bg.fd_st[i] == st {
            if found < 0 {
                if spanEq(src, bg.fd_ns[i], bg.fd_nl[i], s, n) { found = seen }
            }
            seen = seen + 1
        }
        i = i + 1
    }
    return found
}

func scopeFieldTy(src: int[], bg: compilerState, st: int, s: int, n: int): int {
    var i = 0
    while i < bg.fd_st.len() {
        if bg.fd_st[i] == st {
            if spanEq(src, bg.fd_ns[i], bg.fd_nl[i], s, n) { return bg.fd_ty[i] }
        }
        i = i + 1
    }
    return 0
}

func scopeEmitVariant(src: int[], bg: compilerState, code: int[], s: int, n: int): unit {
    let si = internSpan(src, s, n, bg)
    code.push(42)
    pushU32(code, si)
    pushU32(code, 0)
}

func scopeCallOp(code: int[], fn: int, argc: int, async_fn: int): unit {
    if async_fn != 0 {
        code.push(55)
    } else {
        code.push(33)
    }
    pushU32(code, fn)
    pushU32(code, argc)
}

func scopeArgAt(bg: compilerState, c: int, k: int): int {
    let n = consCount(bg, c)
    var cur = c
    var skip = n - 1 - k
    while skip > 0 {
        cur = bg.nc[cur]
        skip = skip - 1
    }
    return bg.nb[cur]
}

func scopeEmitCtor(src: int[], bg: compilerState, cx: compilerContext, code: int[], fat: int[], fb: int[], st: int, args: int): unit {
    var i = 0
    var argi = 0
    var nfields = 0
    let argc = consCount(bg, args)
    while i < bg.fd_st.len() {
        if bg.fd_st[i] == st {
            if argi < argc {
                emitExpr(src, bg, cx, code, fat, fb, scopeArgAt(bg, args, argi))
                argi = argi + 1
            } else {
                if bg.fd_init[i] >= 0 {
                    emitExpr(src, bg, cx, code, fat, fb, bg.fd_init[i])
                } else {
                    emitDefault(bg, code, bg.fd_ty[i])
                }
            }
            nfields = nfields + 1
        }
        i = i + 1
    }
    let si = internSpan(src, bg.st_ns[st], bg.st_nl[st], bg)
    code.push(36)
    pushU32(code, si)
    pushU32(code, nfields)
    cx.expr_ty = st + 1
}

func scopeBuiltinName(src: int[], s: int, n: int): int {
    if isWord(src, s, n, 9, 112, 114, 105, 110, 116, 108, 105, 110, 101, 0, 0, 0) { return 1 }
    if isWord(src, s, n, 7, 112, 114, 105, 110, 116, 108, 110, 0, 0, 0, 0, 0) { return 1 }
    if isWord(src, s, n, 5, 112, 114, 105, 110, 116, 0, 0, 0, 0, 0, 0, 0) { return 1 }
    if isWord(src, s, n, 3, 108, 101, 110, 0, 0, 0, 0, 0, 0, 0, 0, 0) { return 1 }
    if isWord(src, s, n, 6, 108, 101, 110, 103, 116, 104, 0, 0, 0, 0, 0, 0) { return 1 }
    if isWord(src, s, n, 4, 112, 117, 115, 104, 0, 0, 0, 0, 0, 0, 0, 0) { return 1 }
    if isWord(src, s, n, 3, 103, 101, 116, 0, 0, 0, 0, 0, 0, 0, 0, 0) { return 1 }
    if isWord(src, s, n, 10, 114, 101, 97, 100, 95, 98, 121, 116, 101, 115, 0, 0) { return 1 }
    if isWord(src, s, n, 11, 119, 114, 105, 116, 101, 95, 98, 121, 116, 101, 115, 0) { return 1 }
    return 0
}

func scopeEmitCall(src: int[], bg: compilerState, cx: compilerContext, code: int[], fat: int[], fb: int[], nd: int): int {
    let callee = bg.nb[nd]
    let args = bg.nc[nd]
    if callee < 0 { return 0 }
    let ck = bg.nk[callee]
    if ck == 10 {
        let ns = bg.nc[callee]
        let nl = bg.nd[callee]
        if scopeBuiltinName(src, ns, nl) != 0 { return 0 }
        let recv = bg.nb[callee]
        if recv >= 0 && bg.nk[recv] == 4 {
            let rs = bg.na[recv]
            let rn = bg.nb[recv]
            if findLocal(src, bg, cx, rs, rn) < 0 {
                let st = findStruct(src, bg, rs, rn)
                if st >= 0 && bg.st_kind[st] != 3 {
                    let m = scopeFindMethod(src, bg, st, ns, nl)
                    if m >= 0 {
                        emitForward(src, bg, cx, code, fat, fb, args, 0)
                        scopeCallOp(code, m, consCount(bg, args), bg.fn_async[m])
                        cx.expr_ty = 0
                        return 1
                    }
                }
            } else {
                let slot = findLocal(src, bg, cx, rs, rn)
                let ty = localTypeOf(bg, cx, slot)
                if ty > 0 {
                    let st = ty - 1
                    let m = scopeFindMethod(src, bg, st, ns, nl)
                    if m >= 0 {
                        emitExpr(src, bg, cx, code, fat, fb, recv)
                        emitForward(src, bg, cx, code, fat, fb, args, 0)
                        scopeCallOp(code, m, consCount(bg, args) + 1, bg.fn_async[m])
                        cx.expr_ty = 0
                        return 1
                    }
                }
            }
        }
        return 0
    }
    if ck != 4 { return 0 }
    let ns = bg.na[callee]
    let nl = bg.nb[callee]
    if scopeBuiltinName(src, ns, nl) != 0 { return 0 }
    let fn = findFunc(src, bg, ns, nl)
    if fn >= 0 {
        if bg.fn_async[fn] == 0 { return 0 }
        emitForward(src, bg, cx, code, fat, fb, args, 0)
        scopeCallOp(code, fn, consCount(bg, args), 1)
        cx.expr_ty = 0
        return 1
    }
    let st = findStruct(src, bg, ns, nl)
    if st >= 0 && bg.st_kind[st] != 3 {
        scopeEmitCtor(src, bg, cx, code, fat, fb, st, args)
        return 1
    }
    if scopeVariantEn(src, bg, ns, nl) >= 0 && consCount(bg, args) == 0 {
        scopeEmitVariant(src, bg, code, ns, nl)
        cx.expr_ty = 0
        return 1
    }
    if cx.owner >= 0 {
        let m = scopeFindMethod(src, bg, cx.owner, ns, nl)
        if m >= 0 {
            code.push(8)
            pushU32(code, 0)
            emitForward(src, bg, cx, code, fat, fb, args, 0)
            scopeCallOp(code, m, consCount(bg, args) + 1, bg.fn_async[m])
            cx.expr_ty = 0
            return 1
        }
    }
    return 0
}

func scopeEmitEnumMember(src: int[], bg: compilerState, cx: compilerContext, code: int[], nd: int): int {
    if bg.nk[nd] != 10 { return 0 }
    let lhs = bg.nb[nd]
    if lhs < 0 || bg.nk[lhs] != 4 { return 0 }
    if findLocal(src, bg, cx, bg.na[lhs], bg.nb[lhs]) >= 0 { return 0 }
    let st = findStruct(src, bg, bg.na[lhs], bg.nb[lhs])
    if st < 0 { return 0 }
    if bg.st_kind[st] != 3 { return 0 }
    scopeEmitVariant(src, bg, code, bg.nc[nd], bg.nd[nd])
    cx.expr_ty = st + 1
    return 1
}

