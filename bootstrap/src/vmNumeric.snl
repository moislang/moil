package snova.compiler.runtime

func numericBinary(op: int, left: int, right: int): int {
    if op == 12 { return left + right }
    if op == 13 { return left - right }
    if op == 14 { return left * right }
    if op == 15 {
        if right == 0 { return 0 }
        return left / right
    }
    if op == 16 {
        if right == 0 { return 0 }
        return left % right
    }
    if op == 19 { return left & right }
    if op == 20 { return left | right }
    if op == 21 { return left ^ right }
    if op == 22 { return left << (right & 63) }
    if op == 23 { return left >> (right & 63) }
    if op == 24 {
        if left == right { return 1 }
        return 0
    }
    if op == 25 {
        if left != right { return 1 }
        return 0
    }
    if op == 26 {
        if left < right { return 1 }
        return 0
    }
    if op == 27 {
        if left <= right { return 1 }
        return 0
    }
    if op == 28 {
        if left > right { return 1 }
        return 0
    }
    if op == 29 {
        if left >= right { return 1 }
        return 0
    }
    return 0
}

func numericCode(data: int[], start: int, length: int, result: int[]): int {
    var state = numericState {
        top: -1, failed: 0, values: [], previous: [], localSlots: [], localValues: []
    }
    var pc = 0
    while pc < length {
        let op = data[start + pc]
        var next = pc + 1 + opcodeWidth(op)
        if op == 1 {
            let low = codeU32(data, start + pc + 1)
            var high = codeU32(data, start + pc + 5)
            if high >= 2147483648 { high = high - 4294967296 }
            vmPush(state, high * 4294967296 + low)
        } else if op == 4 {
            vmPush(state, data[start + pc + 1])
        } else if op == 5 {
            vmPush(state, 0)
        } else if op == 6 {
            vmPop(state)
        } else if op == 7 {
            vmPush(state, vmPeek(state))
        } else if op == 8 {
            vmPush(state, vmGetLocal(state, codeU32(data, start + pc + 1)))
        } else if op == 9 {
            vmSetLocal(state, codeU32(data, start + pc + 1), vmPeek(state))
        } else if op >= 12 && op <= 16 || op >= 19 && op <= 29 && op != 18 {
            let right = vmPop(state)
            let left = vmPop(state)
            vmPush(state, numericBinary(op, left, right))
        } else if op == 17 {
            let value = vmPop(state)
            vmPush(state, 0 - value)
        } else if op == 18 {
            let value = vmPop(state)
            if value == 0 { vmPush(state, 1) } else { vmPush(state, 0) }
        } else if op == 30 || op == 31 || op == 32 {
            var jump = codeU32(data, start + pc + 1)
            if jump >= 2147483648 { jump = jump - 4294967296 }
            var take = 1
            if op == 31 || op == 32 {
                let value = vmPop(state)
                if op == 31 && value != 0 { take = 0 }
                if op == 32 && value == 0 { take = 0 }
            }
            if take != 0 { next = next + jump }
        } else if op == 35 {
            result.push(vmPop(state))
            if state.failed != 0 { return 0 }
            return 1
        } else if op == 46 {
            result.push(0)
            return 1
        } else {
            return 0
        }
        if state.failed != 0 { return 0 }
        pc = next
    }
    return 0
}

public func runNumericImage(data: int[], result: int[]): int {
    if validateImage(data) == 0 { return 0 }
    if codeU32(data, 8) != 0 { return 0 }
    var cursor = imageCursor { offset: 12, valid: 1 }
    let strings = readU32(data, cursor)
    var i = 0
    while i < strings {
        let size = readU32(data, cursor)
        skipBytes(data, cursor, size)
        i = i + 1
    }
    if readU32(data, cursor) != 1 { return 0 }
    let nameSize = readU32(data, cursor)
    skipBytes(data, cursor, nameSize)
    if readU32(data, cursor) != 0 { return 0 }
    readU32(data, cursor)
    let length = readU32(data, cursor)
    if cursor.valid == 0 { return 0 }
    return numericCode(data, cursor.offset, length, result)
}
