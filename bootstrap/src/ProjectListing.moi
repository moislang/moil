package mois.compiler.project

// Sorted views of a host listing (`read_dir`, SPEC-0003). The kernel order
// of a listing is not deterministic, so every name list is sorted by bytes
// here, in Mois. Name lists are flat: name bytes, then 0, for each name.
class ProjectListing {
    // Permutation that sorts the ranges (starts[i], counts[i]) of `bytes`.
    // Built by insertion into fresh arrays: the root cannot lower `a[i] = v`.
    public method sortedOrder(bytes: int[], starts: int[], counts: int[], text: ProjectText): int[] {
        var order: int[] = []
        var item = 0
        while item < starts.len() {
            var position = 0
            while position < order.len() && text.compareRange(bytes, starts[order[position]], counts[order[position]], bytes, starts[item], counts[item]) <= 0 {
                position = position + 1
            }
            var next: int[] = []
            var index = 0
            while index < order.len() {
                if index == position { next.push(item) }
                next.push(order[index])
                index = index + 1
            }
            if position == order.len() { next.push(item) }
            order = next
            item = item + 1
        }
        return order
    }

    // Sorted `.moi` file names (directories false) or folder names
    // (directories true) of `folder`, whose listing is `listing` with
    // status 0. Kind 0 (unknown to the file system) is probed.
    public method names(listing: int[], folder: int[], directories: bool, text: ProjectText): int[] {
        var starts: int[] = []
        var counts: int[] = []
        var index = 1
        while index < listing.len() {
            let kind = listing[index]
            let start = index + 1
            var end = start
            while listing[end] != 0 { end = end + 1 }
            let name = text.slice(listing, start, end - start)
            var wanted = false
            if directories {
                wanted = kind == 2 || (kind == 0 && isFolder(text.joinPath(folder, name), text))
            } else if text.endsWith(name, text.moiSuffix()) && name.len() > 4 {
                wanted = kind == 1 || (kind == 0 && text.negate(isFolder(text.joinPath(folder, name), text)))
            }
            if wanted {
                starts.push(start)
                counts.push(end - start)
            }
            index = end + 1
        }
        let order = sortedOrder(listing, starts, counts, text)
        var out: int[] = []
        var position = 0
        while position < order.len() {
            var at = 0
            while at < counts[order[position]] {
                out.push(listing[starts[order[position]] + at])
                at = at + 1
            }
            out.push(0)
            position = position + 1
        }
        return out
    }

    private method isFolder(path: int[], text: ProjectText): bool {
        let listing = text.listing(path)
        return listing[0] == 0
    }

    public method nameCount(flat: int[]): int {
        var count = 0
        var index = 0
        while index < flat.len() {
            if flat[index] == 0 { count = count + 1 }
            index = index + 1
        }
        return count
    }

    public method nameAt(flat: int[], which: int): int[] {
        var current = 0
        var out: int[] = []
        var index = 0
        while index < flat.len() {
            if flat[index] == 0 {
                current = current + 1
            } else if current == which {
                out.push(flat[index])
            }
            index = index + 1
        }
        return out
    }
}
