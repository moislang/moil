package mois.compiler

func scopeEmitExpr(src: int[], bg: CompilerState, cx: CompilerContext, code: int[], fat: int[], fb: int[], nd: int): int {
    let k = bg.nk[nd]
    if k == 15 {
        code.push(51)
        cx.expr_ty = 0
        return 1
    }
    if k == 16 {
        emitExpr(src, bg, cx, code, fat, fb, bg.nb[nd])
        return 1
    }
    if k == 17 {
        scopeEmitMatch(src, bg, cx, code, fat, fb, bg.nb[nd], bg.nc[nd], 1, bg.nd[nd])
        return 1
    }
    if k == 10 {
        if scopeEmitEnumMember(src, bg, cx, code, nd) != 0 { return 1 }
        return 0
    }
    if k == 4 && cx.owner >= 0 {
        if findLocal(src, bg, cx, bg.na[nd], bg.nb[nd]) < 0 {
            let fi = scopeFieldIndex(src, bg, cx.owner, bg.na[nd], bg.nb[nd])
            if fi >= 0 {
                code.push(8)
                pushU32(code, 0)
                code.push(37)
                pushU32(code, fi)
                cx.expr_ty = scopeFieldTy(src, bg, cx.owner, bg.na[nd], bg.nb[nd])
                return 1
            }
        }
    }
    if k == 12 && cx.owner >= 0 {
        let lhs = bg.nb[nd]
        if lhs >= 0 && bg.nk[lhs] == 4 {
            if findLocal(src, bg, cx, bg.na[lhs], bg.nb[lhs]) < 0 {
                let fi = scopeFieldIndex(src, bg, cx.owner, bg.na[lhs], bg.nb[lhs])
                if fi >= 0 {
                    emitExpr(src, bg, cx, code, fat, fb, bg.nc[nd])
                    code.push(8)
                    pushU32(code, 0)
                    code.push(38)
                    pushU32(code, fi)
                    return 1
                }
            }
        }
    }
    if k == 7 {
        if scopeEmitCall(src, bg, cx, code, fat, fb, nd) != 0 { return 1 }
    }
    return 0
}

func scopeEmitPattern(src: int[], bg: CompilerState, cx: CompilerContext, code: int[], fat: int[], fb: int[], subj: int, pat: int): unit {
    code.push(8)
    pushU32(code, subj)
    if pat < 0 || bg.na[pat] == 1 {
        code.push(6)
        code.push(4)
        code.push(1)
        return
    }
    if bg.na[pat] == 3 {
        let si = internSpan(src, bg.nb[pat], bg.nc[pat], bg)
        code.push(43)
        pushU32(code, si)
        return
    }
    if bg.na[pat] == 2 {
        emitExpr(src, bg, cx, code, fat, fb, bg.nb[pat])
        code.push(24)
        return
    }
    code.push(6)
    code.push(4)
    code.push(1)
}

func scopeEmitArmValue(src: int[], bg: CompilerState, cx: CompilerContext, code: int[], fat: int[], fb: int[], arm: int, as_value: int): unit {
    if bg.nb[arm] >= 0 {
        emitExpr(src, bg, cx, code, fat, fb, bg.nb[arm])
        if as_value == 0 { code.push(6) }
        return
    }
    if as_value != 0 {
        code.push(5)
    }
}

func scopeEmitArms(src: int[], bg: CompilerState, cx: CompilerContext, code: int[], fat: int[], fb: int[], arms: int, subj: int, as_value: int, ends: int[]): unit {
    if arms < 0 { return }
    scopeEmitArms(src, bg, cx, code, fat, fb, bg.nc[arms], subj, as_value, ends)
    let arm = bg.nb[arms]
    let pat = bg.na[arm]
    scopeEmitPattern(src, bg, cx, code, fat, fb, subj, pat)
    let nxt = emitJump(code, 31)
    if pat >= 0 && bg.na[pat] == 4 {
        if scopeVariantEn(src, bg, bg.nb[pat], bg.nc[pat]) < 0 {
            let slot = addLocalWith(bg, cx, bg.nb[pat], bg.nc[pat], 0, 0)
            code.push(8)
            pushU32(code, subj)
            code.push(9)
            pushU32(code, slot)
            code.push(6)
        }
    }
    scopeEmitArmValue(src, bg, cx, code, fat, fb, arm, as_value)
    ends.push(emitJump(code, 30))
    patchAt(code, fat, fb, nxt)
}

func scopeEmitMatch(src: int[], bg: CompilerState, cx: CompilerContext, code: int[], fat: int[], fb: int[], sub: int, arms: int, as_value: int, matchToken: int): unit {
    let saved = cx.locals
    emitExpr(src, bg, cx, code, fat, fb, sub)
    matchCheckExhaustive(src, bg, cx, cx.expr_ty, arms, matchToken)
    if cx.failed != 0 { return }
    let slot = addLocal(bg, cx, 0, 0, 0)
    code.push(9)
    pushU32(code, slot)
    code.push(6)
    var ends: int[] = []
    scopeEmitArms(src, bg, cx, code, fat, fb, arms, slot, as_value, ends)
    if as_value != 0 {
        code.push(52)
        code.push(5)
    }
    var i = 0
    while i < ends.len() {
        patchAt(code, fat, fb, ends[i])
        i = i + 1
    }
    cx.locals = saved
    cx.expr_ty = 0
}

func scopeEmitFor(src: int[], bg: CompilerState, cx: CompilerContext, code: int[], fat: int[], fb: int[], nd: int): unit {
    let saved = cx.locals
    let is_arr = addLocal(bg, cx, 0, 0, 0)
    let iter = addLocal(bg, cx, 0, 0, 0)
    let idx = addLocal(bg, cx, 0, 0, 0)
    addLocalWith(bg, cx, bg.na[nd], bg.nb[nd], 0, 0)
    let user = idx + 1
    emitExpr(src, bg, cx, code, fat, fb, bg.nc[nd])
    code.push(9)
    pushU32(code, iter)
    code.push(6)
    code.push(8)
    pushU32(code, iter)
    code.push(56)
    code.push(9)
    pushU32(code, is_arr)
    code.push(6)
    code.push(1)
    pushI64(code, 0)
    code.push(9)
    pushU32(code, idx)
    code.push(6)
    let head = code.len()
    code.push(8)
    pushU32(code, is_arr)
    let to_int = emitJump(code, 31)
    code.push(8)
    pushU32(code, idx)
    code.push(8)
    pushU32(code, iter)
    code.push(49)
    code.push(26)
    let arr_exit = emitJump(code, 31)
    code.push(8)
    pushU32(code, iter)
    code.push(8)
    pushU32(code, idx)
    code.push(40)
    code.push(9)
    pushU32(code, user)
    code.push(6)
    let to_body = emitJump(code, 30)
    patchAt(code, fat, fb, to_int)
    code.push(8)
    pushU32(code, idx)
    code.push(8)
    pushU32(code, iter)
    code.push(26)
    let int_exit = emitJump(code, 31)
    code.push(8)
    pushU32(code, idx)
    code.push(9)
    pushU32(code, user)
    code.push(6)
    patchAt(code, fat, fb, to_body)
    scopeLoopEnter(bg, cx, 0, 0)
    if bg.nd[nd] >= 0 {
        emitStmt(src, bg, cx, code, fat, fb, bg.nd[nd])
    }
    scopePatchCont(code, fat, fb, bg)
    code.push(8)
    pushU32(code, idx)
    code.push(1)
    pushI64(code, 1)
    code.push(12)
    code.push(9)
    pushU32(code, idx)
    code.push(6)
    code.push(30)
    let back_at = code.len()
    let back = head - (back_at + 4)
    pushU32(code, back)
    patchAt(code, fat, fb, arr_exit)
    patchAt(code, fat, fb, int_exit)
    scopePatchBrk(code, fat, fb, bg)
    scopeLoopLeave(bg)
    cx.locals = saved
}

func scopeEmitDefer(src: int[], bg: CompilerState, cx: CompilerContext, code: int[], fat: int[], fb: int[], call: int): unit {
    if call < 0 || bg.nk[call] != 7 {
        fail(cx)
        return
    }
    let callee = bg.nb[call]
    if callee < 0 || bg.nk[callee] != 4 {
        fail(cx)
        return
    }
    let fn = findFunc(src, bg, bg.na[callee], bg.nb[callee])
    if fn < 0 {
        fail(cx)
        return
    }
    if arityMismatch(src, bg, cx, fn, consCount(bg, bg.nc[call]), 0, bg.na[callee]) != 0 { return }
    emitForward(src, bg, cx, code, fat, fb, bg.nc[call], 0)
    code.push(53)
    pushU32(code, fn)
    pushU32(code, consCount(bg, bg.nc[call]))
}

func scopeEmitPulsar(src: int[], bg: CompilerState, cx: CompilerContext, code: int[], fat: int[], fb: int[], call: int): unit {
    if call >= 0 && bg.nk[call] == 7 {
        let callee = bg.nb[call]
        if callee >= 0 && bg.nk[callee] == 4 {
            let fn = findFunc(src, bg, bg.na[callee], bg.nb[callee])
            if fn >= 0 {
                if arityMismatch(src, bg, cx, fn, consCount(bg, bg.nc[call]), 0, bg.na[callee]) != 0 { return }
                emitForward(src, bg, cx, code, fat, fb, bg.nc[call], 0)
                code.push(54)
                pushU32(code, fn)
                pushU32(code, consCount(bg, bg.nc[call]))
                return
            }
        }
    }
    if call >= 0 {
        emitExpr(src, bg, cx, code, fat, fb, call)
        code.push(6)
    }
}

func scopeEmitStmt(src: int[], bg: CompilerState, cx: CompilerContext, code: int[], fat: int[], fb: int[], nd: int): int {
    let k = bg.nk[nd]
    if k == 27 {
        scopeEmitBreak(bg, cx, code)
        return 1
    }
    if k == 28 {
        scopeEmitContinue(bg, cx, code)
        return 1
    }
    if k == 29 {
        scopeEmitFor(src, bg, cx, code, fat, fb, nd)
        return 1
    }
    if k == 30 {
        scopeEmitMatch(src, bg, cx, code, fat, fb, bg.nb[nd], bg.nc[nd], 0, bg.nd[nd])
        return 1
    }
    if k == 31 {
        scopeEmitDefer(src, bg, cx, code, fat, fb, bg.nb[nd])
        return 1
    }
    if k == 32 {
        scopeEmitPulsar(src, bg, cx, code, fat, fb, bg.nb[nd])
        return 1
    }
    return 0
}

func scopeWriteFnName(src: int[], bg: CompilerState, image: int[], i: int): unit {
    if bg.fn_own[i] < 0 {
        pushU32(image, bg.fn_nl[i])
        var j = 0
        while j < bg.fn_nl[i] {
            image.push(src[bg.fn_ns[i] + j])
            j = j + 1
        }
        return
    }
    let oi = bg.fn_own[i]
    let ln = bg.st_nl[oi] + 1 + bg.fn_nl[i]
    pushU32(image, ln)
    var j = 0
    while j < bg.st_nl[oi] {
        image.push(src[bg.st_ns[oi] + j])
        j = j + 1
    }
    image.push(46)
    j = 0
    while j < bg.fn_nl[i] {
        image.push(src[bg.fn_ns[i] + j])
        j = j + 1
    }
}
