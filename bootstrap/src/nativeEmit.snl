package snova.compiler.backend

import builtin.runtime

// Backend nativo N1 (ADR-0005): traduz uma imagem SnBC validada para
// assembly aarch64-apple-darwin (AAPCS64, Mach-O). Cobre o subset numérico:
// constantes int/bool/unit, pilha, locais, aritmética, comparações, saltos,
// chamadas, retorno e halt. Qualquer outro opcode faz o backend falhar.
//
// Quadro de cada função: x29 aponta para o par salvo (x29, x30); o local i
// fica em [x29 - 8 * (i + 1)]; a pilha de operandos usa slots de 16 bytes
// abaixo dos locais, mantendo sp alinhado. O argumento i de uma chamada com
// argc argumentos está em [x29 + 16 + 16 * (argc - 1 - i)] na entrada.
struct nativeUnit {
    public var lines: string[]
    public var failedOpcode: int
}

func nativeLine(unit: nativeUnit, text: string): unit {
    unit.lines.push("    " + text)
}

func nativePush(unit: nativeUnit): unit {
    nativeLine(unit, "str x0, [sp, #-16]!")
}

func nativePop(unit: nativeUnit, register: string): unit {
    nativeLine(unit, "ldr " + register + ", [sp], #16")
}

func nativeLabel(functionIndex: int, offset: int): string {
    return "Lsn" + nativeDecimal(functionIndex) + "_" + nativeDecimal(offset)
}

func nativeSymbol(functionIndex: int): string {
    return "_snova_fn_" + nativeDecimal(functionIndex)
}

// Materializa um inteiro de 64 bits em x0 com movz/movk (complemento de dois).
func nativeLoadConstant(unit: nativeUnit, value: int): unit {
    nativeLine(unit, "movz x0, #" + nativeDecimal(value & 65535))
    var part = 1
    while part < 4 {
        let chunk = (value >> (16 * part)) & 65535
        if chunk != 0 {
            nativeLine(unit, "movk x0, #" + nativeDecimal(chunk) + ", lsl #" + nativeDecimal(16 * part))
        }
        part = part + 1
    }
}

func nativeLocalAddress(unit: nativeUnit, slot: int): unit {
    nativeLine(unit, "sub x10, x29, #" + nativeDecimal(8 * (slot + 1)))
}

func nativePrologue(unit: nativeUnit, functionIndex: int, arity: int, localCount: int): unit {
    unit.lines.push("    .p2align 2")
    unit.lines.push(nativeSymbol(functionIndex) + ":")
    nativeLine(unit, "stp x29, x30, [sp, #-16]!")
    nativeLine(unit, "mov x29, sp")
    let frameSize = (8 * localCount + 15) / 16 * 16
    if frameSize > 0 { nativeLine(unit, "sub sp, sp, #" + nativeDecimal(frameSize)) }
    var slot = 0
    while slot < localCount {
        nativeLocalAddress(unit, slot)
        if slot < arity {
            nativeLine(unit, "ldr x9, [x29, #" + nativeDecimal(16 + 16 * (arity - 1 - slot)) + "]")
            nativeLine(unit, "str x9, [x10]")
        } else {
            nativeLine(unit, "str xzr, [x10]")
        }
        slot = slot + 1
    }
}

func nativeEpilogue(unit: nativeUnit): unit {
    nativePop(unit, "x0")
    nativeLine(unit, "mov sp, x29")
    nativeLine(unit, "ldp x29, x30, [sp], #16")
    nativeLine(unit, "ret")
}

func nativeCondition(opcode: int): string {
    if opcode == 24 { return "eq" }
    if opcode == 25 { return "ne" }
    if opcode == 26 { return "lt" }
    if opcode == 27 { return "le" }
    if opcode == 28 { return "gt" }
    return "ge"
}

// Operações binárias: x0 = esquerdo, x1 = direito. Divisão e resto por zero
// dão 0, como no runtime SnBC; sdiv do aarch64 já devolve 0 nesse caso.
func nativeBinary(unit: nativeUnit, opcode: int): unit {
    nativePop(unit, "x1")
    nativePop(unit, "x0")
    if opcode == 12 { nativeLine(unit, "add x0, x0, x1") }
    if opcode == 13 { nativeLine(unit, "sub x0, x0, x1") }
    if opcode == 14 { nativeLine(unit, "mul x0, x0, x1") }
    if opcode == 15 { nativeLine(unit, "sdiv x0, x0, x1") }
    if opcode == 16 {
        nativeLine(unit, "sdiv x2, x0, x1")
        nativeLine(unit, "msub x2, x2, x1, x0")
        nativeLine(unit, "cmp x1, #0")
        nativeLine(unit, "csel x0, xzr, x2, eq")
    }
    if opcode == 19 { nativeLine(unit, "and x0, x0, x1") }
    if opcode == 20 { nativeLine(unit, "orr x0, x0, x1") }
    if opcode == 21 { nativeLine(unit, "eor x0, x0, x1") }
    if opcode == 22 { nativeLine(unit, "lsl x0, x0, x1") }
    if opcode == 23 { nativeLine(unit, "asr x0, x0, x1") }
    if opcode >= 24 && opcode <= 29 {
        nativeLine(unit, "cmp x0, x1")
        nativeLine(unit, "cset x0, " + nativeCondition(opcode))
    }
    nativePush(unit)
}
