package snova.compiler.runtime

struct numericState {
    public var top: int
    public var failed: int
    public var values: int[]
    public var previous: int[]
    public var localSlots: int[]
    public var localValues: int[]
}

func vmPush(state: numericState, value: int): unit {
    state.values.push(value)
    state.previous.push(state.top)
    state.top = state.values.len() - 1
}

func vmPeek(state: numericState): int {
    if state.top < 0 {
        state.failed = 1
        return 0
    }
    return state.values[state.top]
}

func vmPop(state: numericState): int {
    let value = vmPeek(state)
    if state.failed != 0 { return 0 }
    state.top = state.previous[state.top]
    return value
}

func vmGetLocal(state: numericState, slot: int): int {
    var i = state.localSlots.len() - 1
    while i >= 0 {
        if state.localSlots[i] == slot { return state.localValues[i] }
        i = i - 1
    }
    return 0
}

func vmSetLocal(state: numericState, slot: int, value: int): unit {
    state.localSlots.push(slot)
    state.localValues.push(value)
}
