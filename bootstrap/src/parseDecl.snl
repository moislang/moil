package snova.compiler

func parseBinding(src: int[], bg: compilerState, cx: compilerContext): int {
    if cx.failed != 0 { return -1 }
    bump(cx)
    if kindOf(bg, cx) != 1 {
        fail(cx)
        return -1
    }
    let ns = bg.ts[cx.pos]
    let nl = bg.tn[cx.pos]
    bump(cx)
    if atTok(bg, cx, 23) {
        bump(cx)
        parseType(src, bg, cx)
    }
    var init = -1
    if atTok(bg, cx, 27) {
        bump(cx)
        init = parseExpr(src, bg, cx, 1)
    }
    acceptTok(bg, cx, 24)
    return node(bg, 21, ns, nl, init, -1)
}

func parseReturn(src: int[], bg: compilerState, cx: compilerContext): int {
    if cx.failed != 0 { return -1 }
    let ret_line = bg.tl[cx.pos]
    bump(cx)
    var expr = -1
    if atTok(bg, cx, 20) {
        expr = -1
    } else {
        if atTok(bg, cx, 24) {
            expr = -1
        } else {
            if kindOf(bg, cx) == 0 {
                expr = -1
            } else {
                if cx.pos < bg.tl.len() && bg.tl[cx.pos] == ret_line {
                    expr = parseExpr(src, bg, cx, 1)
                }
            }
        }
    }
    acceptTok(bg, cx, 24)
    return node(bg, 23, 0, expr, -1, -1)
}

func parseBody(src: int[], bg: compilerState, cx: compilerContext): int {
    if atTok(bg, cx, 19) {
        return parseBlock(src, bg, cx)
    }
    return parseStmt(src, bg, cx)
}

func parseIf(src: int[], bg: compilerState, cx: compilerContext): int {
    if cx.failed != 0 { return -1 }
    bump(cx)
    let saved = cx.no_struct
    cx.no_struct = 1
    let cond = parseExpr(src, bg, cx, 1)
    cx.no_struct = saved
    let th = parseBody(src, bg, cx)
    var el = -1
    if atTok(bg, cx, 15) {
        bump(cx)
        el = parseBody(src, bg, cx)
    }
    return node(bg, 24, 0, cond, th, el)
}

func parseWhile(src: int[], bg: compilerState, cx: compilerContext): int {
    if cx.failed != 0 { return -1 }
    bump(cx)
    let saved = cx.no_struct
    cx.no_struct = 1
    let cond = parseExpr(src, bg, cx, 1)
    cx.no_struct = saved
    let body = parseBody(src, bg, cx)
    return node(bg, 25, 0, cond, body, -1)
}

func parseBlock(src: int[], bg: compilerState, cx: compilerContext): int {
    if cx.failed != 0 { return -1 }
    expectTok(bg, cx, 19)
    var head = -1
    var go = 1
    while go == 1 {
        if cx.failed != 0 {
            go = 0
        } else {
            if atTok(bg, cx, 20) {
                go = 0
            } else {
                if kindOf(bg, cx) == 0 {
                    fail(cx)
                    go = 0
                } else {
                    let st = parseStmt(src, bg, cx)
                    head = node(bg, 13, 0, st, head, -1)
                }
            }
        }
    }
    expectTok(bg, cx, 20)
    return node(bg, 26, 0, -1, head, -1)
}

func parseStmt(src: int[], bg: compilerState, cx: compilerContext): int {
    if cx.failed != 0 { return -1 }
    let k = kindOf(bg, cx)
    if k == 11 || k == 12 { return parseBinding(src, bg, cx) }
    if k == 19 { return parseBlock(src, bg, cx) }
    if k == 13 { return parseReturn(src, bg, cx) }
    if k == 14 { return parseIf(src, bg, cx) }
    if k == 16 { return parseWhile(src, bg, cx) }
    let scoped = parseScopeStmt(src, bg, cx)
    if scoped != -2 { return scoped }
    let e = parseExpr(src, bg, cx, 1)
    acceptTok(bg, cx, 24)
    return node(bg, 20, 0, e, -1, -1)
}

func parseDotted(src: int[], bg: compilerState, cx: compilerContext): unit {
    expectTok(bg, cx, 1)
    var go = 1
    while go == 1 {
        if cx.failed != 0 {
            go = 0
        } else {
            if atTok(bg, cx, 26) {
                bump(cx)
                expectTok(bg, cx, 1)
            } else {
                go = 0
            }
        }
    }
    acceptTok(bg, cx, 24)
}

func parseStruct(src: int[], bg: compilerState, cx: compilerContext): unit {
    if cx.failed != 0 { return }
    bump(cx)
    if kindOf(bg, cx) != 1 {
        fail(cx)
        return
    }
    let ns = bg.ts[cx.pos]
    let nl = bg.tn[cx.pos]
    bump(cx)
    let st = bg.st_ns.len()
    bg.st_ns.push(ns)
    bg.st_nl.push(nl)
    bg.st_kind.push(0)
    expectTok(bg, cx, 19)
    var go = 1
    while go == 1 {
        if cx.failed != 0 {
            go = 0
        } else {
            if atTok(bg, cx, 20) {
                go = 0
            } else {
                if kindOf(bg, cx) == 0 {
                    fail(cx)
                    go = 0
                } else {
                    if atTok(bg, cx, 10) {
                        bump(cx)
                    }
                    if atTok(bg, cx, 11) || atTok(bg, cx, 12) {
                        bump(cx)
                        if kindOf(bg, cx) != 1 {
                            fail(cx)
                            go = 0
                        } else {
                            let fs = bg.ts[cx.pos]
                            let fl = bg.tn[cx.pos]
                            bump(cx)
                            expectTok(bg, cx, 23)
                            let ty = parseType(src, bg, cx)
                            if atTok(bg, cx, 27) {
                                fail(cx)
                                go = 0
                            } else {
                                if atTok(bg, cx, 19) {
                                    fail(cx)
                                    go = 0
                                } else {
                                    acceptTok(bg, cx, 24)
                                    bg.fd_st.push(st)
                                    bg.fd_ns.push(fs)
                                    bg.fd_nl.push(fl)
                                    bg.fd_ty.push(ty)
                                    bg.fd_init.push(-1)
                                }
                            }
                        }
                    } else {
                        fail(cx)
                        go = 0
                    }
                }
            }
        }
    }
    expectTok(bg, cx, 20)
}

func parseParams(src: int[], bg: compilerState, cx: compilerContext, fi: int): int {
    var arity = 0
    if atTok(bg, cx, 18) {
        return 0
    }
    var go = 1
    while go == 1 {
        if cx.failed != 0 {
            go = 0
        } else {
            if kindOf(bg, cx) != 1 {
                fail(cx)
                go = 0
            } else {
                let ps = bg.ts[cx.pos]
                let pl = bg.tn[cx.pos]
                bump(cx)
                expectTok(bg, cx, 23)
                let ty = parseType(src, bg, cx)
                bg.par_fn.push(fi)
                bg.par_ns.push(ps)
                bg.par_nl.push(pl)
                bg.par_ty.push(ty)
                arity = arity + 1
                if atTok(bg, cx, 25) {
                    bump(cx)
                    if atTok(bg, cx, 18) {
                        go = 0
                    }
                } else {
                    go = 0
                }
            }
        }
    }
    return arity
}

func parseFunc(src: int[], bg: compilerState, cx: compilerContext): unit {
    if cx.failed != 0 { return }
    bump(cx)
    if kindOf(bg, cx) != 1 {
        fail(cx)
        return
    }
    let ns = bg.ts[cx.pos]
    let nl = bg.tn[cx.pos]
    bump(cx)
    let fi = bg.fn_ns.len()
    bg.fn_ns.push(ns)
    bg.fn_nl.push(nl)
    bg.fn_own.push(cx.decl_owner)
    bg.fn_async.push(cx.decl_async)
    bg.fn_pulsar.push(cx.decl_pulsar)
    if cx.decl_owner < 0 {
        if isWord(src, ns, nl, 4, 109, 97, 105, 110, 0, 0, 0, 0, 0, 0, 0, 0) {
            cx.main_idx = fi
        }
    }
    expectTok(bg, cx, 17)
    let arity = parseParams(src, bg, cx, fi)
    expectTok(bg, cx, 18)
    if atTok(bg, cx, 23) {
        bump(cx)
        parseType(src, bg, cx)
    }
    var body = -1
    if atTok(bg, cx, 19) {
        body = parseBlock(src, bg, cx)
    } else {
        if atTok(bg, cx, 27) {
            bump(cx)
            let expr = parseExpr(src, bg, cx, 1)
            let ret = node(bg, 23, 0, expr, -1, -1)
            let head = node(bg, 13, 0, ret, -1, -1)
            body = node(bg, 26, 0, -1, head, -1)
            acceptTok(bg, cx, 24)
        } else {
            acceptTok(bg, cx, 24)
        }
    }
    if cx.decl_owner >= 0 {
        bg.fn_ar.push(arity + 1)
    } else {
        bg.fn_ar.push(arity)
    }
    bg.fn_body.push(body)
}

func parseFile(src: int[], bg: compilerState, cx: compilerContext): unit {
    cx.phase = 2
    if atTok(bg, cx, 6) {
        bump(cx)
        parseDotted(src, bg, cx)
    }
    var go = 1
    while go == 1 {
        if cx.failed != 0 {
            go = 0
        } else {
            if atTok(bg, cx, 7) {
                bump(cx)
                parseDotted(src, bg, cx)
            } else {
                go = 0
            }
        }
    }
    go = 1
    while go == 1 {
        if cx.failed != 0 {
            go = 0
        } else {
            if kindOf(bg, cx) == 0 {
                go = 0
            } else {
                scopeTakeMods(src, bg, cx)
                if atTok(bg, cx, 8) {
                    parseStruct(src, bg, cx)
                } else {
                    if atTok(bg, cx, 9) || atTok(bg, cx, 60) {
                        parseFunc(src, bg, cx)
                    } else {
                        if parseScopeDecl(src, bg, cx) == 0 {
                            fail(cx)
                            go = 0
                        }
                    }
                }
            }
        }
    }
}

