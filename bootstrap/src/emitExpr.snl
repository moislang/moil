package snova.compiler

func isArgumentCount(src: int[], start: int, count: int): bool {
    if count != 13 { return false }
    return src[start] == 97 && src[start + 1] == 114 && src[start + 2] == 103 &&
        src[start + 3] == 117 && src[start + 4] == 109 && src[start + 5] == 101 &&
        src[start + 6] == 110 && src[start + 7] == 116 && src[start + 8] == 67 &&
        src[start + 9] == 111 && src[start + 10] == 117 && src[start + 11] == 110 &&
        src[start + 12] == 116
}

func runtimeCallId(src: int[], start: int, count: int): int {
    if isWord(src, start, count, 11, 101, 110, 118, 105, 114, 111, 110, 109, 101, 110, 116, 0) { return 5 }
    if isArgumentCount(src, start, count) { return 6 }
    if isWord(src, start, count, 8, 97, 114, 103, 117, 109, 101, 110, 116, 0, 0, 0, 0) { return 7 }
    if isWord(src, start, count, 9, 119, 114, 105, 116, 101, 84, 101, 120, 116, 0, 0, 0) { return 4 }
    if isWord(src, start, count, 10, 102, 105, 108, 101, 69, 120, 105, 115, 116, 115, 0, 0) { return 2 }
    if isWord(src, start, count, 8, 114, 101, 97, 100, 84, 101, 120, 116, 0, 0, 0, 0) { return 3 }
    return 0
}

// Arity of the Runtime methods the seed accepts (SnBC runtime call ids).
func runtimeCallArity(callId: int): int {
    if callId == 6 { return 0 }
    if callId == 4 { return 2 }
    return 1
}

func emitCall(src: int[], bg: compilerState, cx: compilerContext, code: int[], fat: int[], fb: int[], callee: int, args: int): unit {
    if callee < 0 {
        fail(cx)
        return
    }
    let ck = bg.nk[callee]
    var ns = 0
    var nl = 0
    if ck == 4 {
        ns = bg.na[callee]
        nl = bg.nb[callee]
    }
    if ck == 10 {
        ns = bg.nc[callee]
        nl = bg.nd[callee]
        let recv = bg.nb[callee]
        if recv >= 0 && bg.nk[recv] == 4 && isWord(src, bg.na[recv], bg.nb[recv], 7, 82, 117, 110, 116, 105, 109, 101, 0, 0, 0, 0, 0) {
            let callId = runtimeCallId(src, ns, nl)
            if callId != 0 {
                let argc = consCount(bg, args)
                if argc != runtimeCallArity(callId) {
                    fail(cx)
                    return
                }
                emitForward(src, bg, cx, code, fat, fb, args, 0)
                code.push(57)
                pushU32(code, callId)
                pushU32(code, argc)
                cx.expr_ty = -3
                if callId == 6 { cx.expr_ty = -1 }
                if callId == 4 || callId == 2 { cx.expr_ty = -2 }
                return
            }
        }
    }
    if ck == 4 || ck == 10 {
        let which = namePrint(src, ns, nl)
        if which != 0 {
            emitPrint(src, bg, cx, code, fat, fb, args, which)
            return
        }
    }
    if ck == 4 && isWord(src, ns, nl, 10, 114, 101, 97, 100, 95, 98, 121, 116, 101, 115, 0, 0) && consCount(bg, args) == 1 {
        emitExpr(src, bg, cx, code, fat, fb, consFirst(bg, args))
        code.push(47)
        cx.expr_ty = 0
        return
    }
    if ck == 4 && isWord(src, ns, nl, 11, 119, 114, 105, 116, 101, 95, 98, 121, 116, 101, 115, 0) && consCount(bg, args) == 2 {
        emitForward(src, bg, cx, code, fat, fb, args, 0)
        code.push(48)
        cx.expr_ty = 0
        return
    }
    if ck == 10 {
        let argc = consCount(bg, args)
        let recv = bg.nb[callee]
        if argc == 0 && (isWord(src, ns, nl, 3, 108, 101, 110, 0, 0, 0, 0, 0, 0, 0, 0, 0) || isWord(src, ns, nl, 6, 108, 101, 110, 103, 116, 104, 0, 0, 0, 0, 0, 0)) {
            emitExpr(src, bg, cx, code, fat, fb, recv)
            code.push(49)
            cx.expr_ty = -1
            return
        }
        if argc == 1 && isWord(src, ns, nl, 4, 112, 117, 115, 104, 0, 0, 0, 0, 0, 0, 0, 0) {
            emitExpr(src, bg, cx, code, fat, fb, recv)
            emitExpr(src, bg, cx, code, fat, fb, consFirst(bg, args))
            code.push(50)
            cx.expr_ty = -1
            return
        }
        if argc == 1 && isWord(src, ns, nl, 3, 103, 101, 116, 0, 0, 0, 0, 0, 0, 0, 0, 0) {
            emitExpr(src, bg, cx, code, fat, fb, recv)
            emitExpr(src, bg, cx, code, fat, fb, consFirst(bg, args))
            code.push(40)
            cx.expr_ty = 0
            return
        }
    }
    var fn = -1
    if ck == 4 {
        fn = findFunc(src, bg, ns, nl)
    }
    emitForward(src, bg, cx, code, fat, fb, args, 0)
    if fn >= 0 {
        code.push(33)
        pushU32(code, fn)
        pushU32(code, consCount(bg, args))
        cx.expr_ty = 0
    } else {
        fail(cx)
    }
}

func emitStruct(src: int[], bg: compilerState, cx: compilerContext, code: int[], fat: int[], fb: int[], nd: int): unit {
    let ns = bg.na[nd]
    let nl = bg.nb[nd]
    let st = findStruct(src, bg, ns, nl)
    if st < 0 {
        fail(cx)
        return
    }
    var known = 0
    if structFieldsKnown(src, bg, st, bg.nc[nd]) {
        known = 1
    }
    if known == 0 {
        fail(cx)
        return
    }
    var nfields = 0
    var i = 0
    while i < bg.fd_st.len() {
        if bg.fd_st[i] == st {
            let val = fieldValue(src, bg, bg.nc[nd], bg.fd_ns[i], bg.fd_nl[i])
            if val >= 0 {
                if bg.fd_ty[i] == -1 && bg.nk[val] == 3 {
                    fail(cx)
                    return
                } else {
                    if bg.fd_ty[i] == -3 && bg.nk[val] == 1 {
                        fail(cx)
                        return
                    } else {
                        emitExpr(src, bg, cx, code, fat, fb, val)
                    }
                }
            } else {
                emitDefault(bg, code, bg.fd_ty[i])
            }
            nfields = nfields + 1
        }
        i = i + 1
    }
    let si = internSpan(src, ns, nl, bg)
    code.push(36)
    pushU32(code, si)
    pushU32(code, nfields)
    cx.expr_ty = st + 1
}

func emitAssign(src: int[], bg: compilerState, cx: compilerContext, code: int[], fat: int[], fb: int[], lhs: int, rhs: int): unit {
    emitExpr(src, bg, cx, code, fat, fb, rhs)
    let rhs_ty = cx.expr_ty
    if lhs < 0 {
        fail(cx)
        return
    }
    if bg.nk[lhs] == 4 {
        let slot = findLocal(src, bg, cx, bg.na[lhs], bg.nb[lhs])
        if slot < 0 {
            fail(cx)
            return
        }
        code.push(9)
        pushU32(code, slot)
        setLocalTy(bg, cx, slot, rhs_ty)
        cx.expr_ty = rhs_ty
        return
    }
    if bg.nk[lhs] == 10 {
        emitExpr(src, bg, cx, code, fat, fb, bg.nb[lhs])
        let ty = cx.expr_ty
        var st = -1
        if ty > 0 {
            st = ty - 1
        }
        let fi = fieldIndex(src, bg, st, bg.nc[lhs], bg.nd[lhs])
        if fi < 0 {
            fail(cx)
            return
        }
        code.push(38)
        pushU32(code, fi)
        cx.expr_ty = fieldTypeAt(src, bg, st, bg.nc[lhs], bg.nd[lhs])
        return
    }
    fail(cx)
}

func emitMember(src: int[], bg: compilerState, cx: compilerContext, code: int[], fat: int[], fb: int[], nd: int): unit {
    emitExpr(src, bg, cx, code, fat, fb, bg.nb[nd])
    let ty = cx.expr_ty
    var st = -1
    if ty > 0 {
        st = ty - 1
    }
    let fi = fieldIndex(src, bg, st, bg.nc[nd], bg.nd[nd])
    if fi < 0 {
        fail(cx)
        return
    }
    code.push(37)
    pushU32(code, fi)
    cx.expr_ty = fieldTypeAt(src, bg, st, bg.nc[nd], bg.nd[nd])
}

