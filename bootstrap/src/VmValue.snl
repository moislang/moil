package mois.compiler.runtime

// Values of the SnBC executor: each value is a (tag, value) pair.
// tag 0 unit, 1 int, 2 bool, 3 string (value = handle into strings),
// 4 array (value = index into arrays), 5 object (value = index into
// objectStart), 6 null, 7 unit enum variant (value = string handle of
// the variant name). The seed subset has no index assignment, so every
// mutable position is a cell (struct) changed through a typed parameter.
struct VmCell {
    public var tag: int
    public var value: int
}

// Guest array. While mixed == 0 every element is an int and tags stays
// empty; the first element of another type materializes the tags.
struct VmArray {
    public var mixed: int
    public var tags: int[]
    public var values: int[]
}

// Saved frame of a calling function: the executor is iterative and does not
// use the host call stack for guest calls.
struct VmFrameRecord {
    public var functionIndex: int
    public var base: int
    public var floor: int
    public var resume: int
}

struct VmState {
    public var data: int[]
    public var functionFirst: int[]
    public var functionLength: int[]
    public var instructionOpcode: int[]
    public var instructionOperand: int[]
    public var instructionSecondOperand: int[]
    public var functionArity: int[]
    public var functionLocals: int[]
    // VM string handles for fully qualified method names, used by dispatch.
    public var functionName: int[]
    // Function indexes sorted by qualified-name bytes for O(log n) dispatch lookup.
    public var functionOrder: int[]
    public var poolHandles: int[]
    public var strings: string[]
    public var stringSpans: VmCell[]
    public var stringBytes: int[]
    public var text: string[]
    public var stack: VmCell[]
    public var frames: VmFrameRecord[]
    public var resumeFunction: int
    public var resumeBase: int
    public var resumeFloor: int
    public var resumeInstruction: int
    public var arrays: VmArray[]
    public var objectStart: int[]
    public var objectFieldCount: int[]
    // String-pool index from NEW_OBJECT, retained for runtime method dispatch.
    public var objectType: int[]
    public var fields: VmCell[]
    public var stackTop: int
    public var floor: int
    public var depth: int
    public var returnTag: int
    public var returnValue: int
    public var halted: int
    public var failed: int
    public var failureDetail: int
    public var argumentBase: int
    public var mainIndex: int
}

func cellSet(cell: VmCell, tag: int, value: int): unit {
    cell.tag = tag
    cell.value = value
}

func cellCopy(target: VmCell, source: VmCell): unit {
    target.tag = source.tag
    target.value = source.value
}

func frameSave(record: VmFrameRecord, functionIndex: int, base: int, floor: int, resume: int): unit {
    record.functionIndex = functionIndex
    record.base = base
    record.floor = floor
    record.resume = resume
}

func frameRestore(record: VmFrameRecord, vm: VmState): unit {
    vm.resumeFunction = record.functionIndex
    vm.resumeBase = record.base
    vm.resumeFloor = record.floor
    vm.resumeInstruction = record.resume
}

func cellTag(cell: VmCell): int {
    return cell.tag
}

func cellValue(cell: VmCell): int {
    return cell.value
}

func vmFail(vm: VmState, failureCode: int, failureDetail: int): unit {
    if vm.failed == 0 {
        vm.failed = failureCode
        vm.failureDetail = failureDetail
    }
}

func vmGrow(vm: VmState): unit {
    vm.stack.push(VmCell { tag: 0, value: 0 })
}

func vmPush(vm: VmState, tag: int, value: int): unit {
    if vm.stackTop == vm.stack.len() {
        vm.stack.push(VmCell { tag: tag, value: value })
    } else {
        cellSet(vm.stack[vm.stackTop], tag, value)
    }
    vm.stackTop = vm.stackTop + 1
}

func vmTopTag(vm: VmState): int {
    if vm.stackTop <= vm.floor {
        vmFail(vm, 1, 0)
        return 0
    }
    return cellTag(vm.stack[vm.stackTop - 1])
}

func vmPop(vm: VmState): int {
    if vm.stackTop <= vm.floor {
        vmFail(vm, 1, 0)
        return 0
    }
    vm.stackTop = vm.stackTop - 1
    return cellValue(vm.stack[vm.stackTop])
}

func arrayLen(array: VmArray): int {
    return array.values.len()
}

func arrayTag(array: VmArray, index: int): int {
    if array.mixed == 0 { return 1 }
    return array.tags[index]
}

func arrayValue(array: VmArray, index: int): int {
    return array.values[index]
}

func arrayPush(array: VmArray, tag: int, value: int): unit {
    if array.mixed == 0 && tag != 1 {
        var index = 0
        while index < array.values.len() {
            array.tags.push(1)
            index = index + 1
        }
        array.mixed = 1
    }
    if array.mixed != 0 { array.tags.push(tag) }
    array.values.push(value)
}

func vmNewArray(vm: VmState, count: int): int {
    if count > vm.stackTop - vm.floor {
        vmFail(vm, 1, 0)
        return 0
    }
    var array = VmArray { mixed: 0, tags: [], values: [] }
    let first = vm.stackTop - count
    var index = 0
    while index < count {
        arrayPush(array, cellTag(vm.stack[first + index]), cellValue(vm.stack[first + index]))
        index = index + 1
    }
    vm.stackTop = first
    vm.arrays.push(array)
    return vm.arrays.len() - 1
}

func vmBytesArray(vm: VmState, bytes: int[]): int {
    vm.arrays.push(VmArray { mixed: 0, tags: [], values: bytes })
    return vm.arrays.len() - 1
}

func vmNewObject(vm: VmState, typeName: int, count: int): int {
    if count > vm.stackTop - vm.floor {
        vmFail(vm, 1, 0)
        return 0
    }
    let first = vm.stackTop - count
    vm.objectStart.push(vm.fields.len())
    vm.objectFieldCount.push(count)
    vm.objectType.push(typeName)
    var index = 0
    while index < count {
        vm.fields.push(VmCell { tag: cellTag(vm.stack[first + index]), value: cellValue(vm.stack[first + index]) })
        index = index + 1
    }
    vm.stackTop = first
    return vm.objectStart.len() - 1
}

func vmCompareFunctionNames(vm: VmState, leftIndex: int, rightIndex: int): int {
    let leftHandle = vm.functionName[leftIndex]
    let rightHandle = vm.functionName[rightIndex]
    let leftLength = vmStringLength(vm, leftHandle)
    let rightLength = vmStringLength(vm, rightHandle)
    let leftStart = vmStringStart(vm, leftHandle)
    let rightStart = vmStringStart(vm, rightHandle)
    var index = 0
    while index < leftLength && index < rightLength {
        let leftByte = vm.stringBytes[leftStart + index]
        let rightByte = vm.stringBytes[rightStart + index]
        if leftByte < rightByte { return -1 }
        if leftByte > rightByte { return 1 }
        index = index + 1
    }
    if leftLength < rightLength { return -1 }
    if leftLength > rightLength { return 1 }
    return 0
}

func vmCompareMethodName(vm: VmState, functionHandle: int, typeHandle: int, methodHandle: int): int {
    let typeLength = vmStringLength(vm, typeHandle)
    let methodLength = vmStringLength(vm, methodHandle)
    let functionLength = vmStringLength(vm, functionHandle)
    if functionLength <= typeLength { return -1 }
    let functionStart = vmStringStart(vm, functionHandle)
    let typeStart = vmStringStart(vm, typeHandle)
    let methodStart = vmStringStart(vm, methodHandle)
    var index = 0
    while index < typeLength {
        let functionByte = vm.stringBytes[functionStart + index]
        let typeByte = vm.stringBytes[typeStart + index]
        if functionByte < typeByte { return -1 }
        if functionByte > typeByte { return 1 }
        index = index + 1
    }
    let separator = vm.stringBytes[functionStart + typeLength]
    if separator < 46 { return -1 }
    if separator > 46 { return 1 }
    let functionMethodLength = functionLength - typeLength - 1
    index = 0
    while index < methodLength && index < functionMethodLength {
        let functionByte = vm.stringBytes[functionStart + typeLength + index + 1]
        let methodByte = vm.stringBytes[methodStart + index]
        if functionByte < methodByte { return -1 }
        if functionByte > methodByte { return 1 }
        index = index + 1
    }
    if functionMethodLength < methodLength { return -1 }
    if functionMethodLength > methodLength { return 1 }
    return 0
}

func vmMergeFunctionOrder(vm: VmState, left: int[], right: int[]): int[] {
    var merged: int[] = []
    var leftIndex = 0
    var rightIndex = 0
    while leftIndex < left.len() && rightIndex < right.len() {
        if vmCompareFunctionNames(vm, left[leftIndex], right[rightIndex]) <= 0 {
            merged.push(left[leftIndex])
            leftIndex = leftIndex + 1
        } else {
            merged.push(right[rightIndex])
            rightIndex = rightIndex + 1
        }
    }
    while leftIndex < left.len() {
        merged.push(left[leftIndex])
        leftIndex = leftIndex + 1
    }
    while rightIndex < right.len() {
        merged.push(right[rightIndex])
        rightIndex = rightIndex + 1
    }
    return merged
}

func vmSortFunctionOrder(vm: VmState, indexes: int[]): int[] {
    let count = indexes.len()
    if count < 2 {
        var single: int[] = []
        if count == 1 { single.push(indexes[0]) }
        return single
    }
    let split = count / 2
    var left: int[] = []
    var right: int[] = []
    var index = 0
    while index < split {
        left.push(indexes[index])
        index = index + 1
    }
    while index < count {
        right.push(indexes[index])
        index = index + 1
    }
    let sortedLeft = vmSortFunctionOrder(vm, left)
    let sortedRight = vmSortFunctionOrder(vm, right)
    return vmMergeFunctionOrder(vm, sortedLeft, sortedRight)
}

func vmIndexFunctionNames(vm: VmState): unit {
    var indexes: int[] = []
    var index = 0
    while index < vm.functionName.len() {
        indexes.push(index)
        index = index + 1
    }
    vm.functionOrder = vmSortFunctionOrder(vm, indexes)
}

func vmResolveMethod(vm: VmState, objectHandle: int, methodNameIndex: int): int {
    let concreteTypeIndex = vm.objectType[objectHandle]
    let typeHandle = vm.poolHandles[concreteTypeIndex]
    let methodHandle = vm.poolHandles[methodNameIndex]
    var low = 0
    var high = vm.functionOrder.len()
    while low < high {
        let middle = low + (high - low) / 2
        let functionIndex = vm.functionOrder[middle]
        let comparison = vmCompareMethodName(vm, vm.functionName[functionIndex], typeHandle, methodHandle)
        if comparison < 0 {
            low = middle + 1
        } else if comparison > 0 {
            high = middle
        } else {
            return functionIndex
        }
    }
    return -1
}
