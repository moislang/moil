package snova.compiler

import snova.compiler.runtime
import snova.compiler.backend

func writeImage(src: int[], bg: compilerState, cx: compilerContext, image: int[]): unit {
    image.push(83)
    image.push(78)
    image.push(66)
    image.push(67)
    pushU32(image, 1)
    pushU32(image, cx.main_idx)
    pushU32(image, bg.pool_n.len())
    var i = 0
    while i < bg.pool_n.len() {
        pushU32(image, bg.pool_n[i])
        var j = 0
        while j < bg.pool_n[i] {
            image.push(bg.pool_b[bg.pool_s[i] + j])
            j = j + 1
        }
        i = i + 1
    }
    pushU32(image, bg.fn_ns.len())
    i = 0
    while i < bg.fn_ns.len() {
        scopeWriteFnName(src, bg, image, i)
        pushU32(image, bg.fn_ar[i])
        pushU32(image, bg.fn_loc[i])
        pushU32(image, bg.fn_len[i])
        var j = 0
        while j < bg.fn_len[i] {
            image.push(bg.allc[bg.fn_off[i] + j])
            j = j + 1
        }
        i = i + 1
    }
}

func reportFailure(bg: compilerState, cx: compilerContext): unit {
    if cx.error_phase == 1 {
        Console.print("lexical error at line ")
        Console.print(cx.error_line)
        Console.printline("")
        return
    }
    if cx.error_phase == 2 {
        var line = 1
        if cx.error_token >= 0 && cx.error_token < bg.tl.len() {
            line = bg.tl[cx.error_token]
        }
        Console.print("parse error at line ")
        Console.print(line)
        Console.printline("")
        return
    }
    Console.printline("unsupported construct or invalid lowering")
}

// Warnings não interrompem a compilação. SNW0001: `==`/`!=` entre operandos
// cujos tipos estáticos são conhecidos e diferentes.
func reportWarnings(bg: compilerState): unit {
    var index = 0
    while index < bg.warningCodes.len() {
        Console.print("warning[SNW000")
        Console.print(bg.warningCodes[index])
        Console.print("]: comparison between different types at line ")
        Console.print(bg.warningLines[index])
        Console.printline("")
        index = index + 1
    }
}

func compileSource(src: int[], image: int[]): int {
    var bg = compilerState {
        tk: [], ts: [], tn: [], tv: [], tl: [],
        nk: [], na: [], nb: [], nc: [], nd: [],
        loc_slot: [], loc_ns: [], loc_nl: [], loc_ty: [],
        fd_st: [], fd_ns: [], fd_nl: [], fd_ty: [],
        st_ns: [], st_nl: [],
        fn_ns: [], fn_nl: [], fn_ar: [], fn_body: [],
        fn_off: [], fn_len: [], fn_loc: [],
        par_fn: [], par_ns: [], par_nl: [], par_ty: [],
        pool_b: [], pool_s: [], pool_n: [],
        allc: [],
        fn_own: [], fn_async: [], fn_pulsar: [],
        st_kind: [], fd_init: [],
        va_ns: [], va_nl: [], va_en: [],
        lp_id: [], lp_known: [], lp_pos: [],
        brk_at: [], brk_lv: [], cont_at: [], cont_lv: [],
        warningCodes: [], warningLines: []
    }
    var cx = compilerContext {
        pos: 0, failed: 0, locals: 0, water: 0, expr_ty: 0,
        no_struct: 0, loc_base: 0, main_idx: 0,
        owner: -1, seq: 1, decl_async: 0, decl_pulsar: 0, decl_owner: -1,
        phase: 0, error_phase: 0, error_token: -1, error_line: 1, line: 1
    }
    lexAll(src, bg, cx)
    if cx.failed != 0 {
        reportFailure(bg, cx)
        return 1
    }
    parseFile(src, bg, cx)
    if cx.failed != 0 {
        reportFailure(bg, cx)
        return 1
    }
    if bg.fn_ns.len() == 0 {
        fail(cx)
        reportFailure(bg, cx)
        return 1
    }
    cx.phase = 3
    emitUnit(src, bg, cx)
    if cx.failed != 0 {
        reportFailure(bg, cx)
        return 1
    }
    if bg.fn_loc.len() != bg.fn_ns.len() {
        fail(cx)
        reportFailure(bg, cx)
        return 1
    }
    reportWarnings(bg)
    writeImage(src, bg, cx, image)
    return 0
}

public func compileBytes(src: int[], image: int[]): int {
    return compileSource(src, image)
}

// O modo de execução é reconhecido pelo magic SNBC no primeiro argumento.
// O segundo argumento é a palavra reservada `run`; os seguintes são do programa.
func isImageBytes(data: int[]): bool {
    if data.len() < 4 { return false }
    return data[0] == 83 && data[1] == 78 && data[2] == 66 && data[3] == 67
}

func main(): int {
    let argc = cliArgumentCount()
    if argc == 1 {
        if validateImage(readSource(sourcePath())) == 0 {
            Console.printline("invalid SnBC image")
            return 1
        }
        Console.printline("valid SnBC image")
        return 0
    }
    if argc != 0 && argc < 2 {
        Console.printline("usage: snl <input.snl> <output.snbc> | snl <input.snl> <output.s> native | snl <image.snbc> [run [args...]]")
        return 2
    }
    var src: int[] = []
    if argc == 0 {
        src = ownSource()
    } else {
        src = readSource(sourcePath())
        if isImageBytes(src) {
            return runImage(src, 2)
        }
    }
    var image: int[] = []
    if compileSource(src, image) != 0 {
        return 1
    }
    if validateImage(image) == 0 {
        Console.printline("invalid generated SnBC image")
        return 1
    }
    if argc == 3 {
        let unsupported = emitNativeAssembly(image, imagePath())
        if unsupported != 0 {
            Console.print("unsupported opcode for native backend: ")
            Console.printline(unsupported)
            return 1
        }
        return 0
    }
    writeImageFile(imagePath(), image)
    return 0
}
