package snova.compiler.runtime

import builtin.runtime

// Limite de quadros igual a SN_VM_FRAMES_MAX do runtime de referência.
func vmFrameLimit(): int {
    return 256
}

func vmSigned32(value: int): int {
    if value >= 2147483648 { return value - 4294967296 }
    return value
}

func vmConstInt(data: int[], at: int): int {
    let low = codeU32(data, at)
    let high = vmSigned32(codeU32(data, at + 4))
    return high * 4294967296 + low
}

func vmEnterLocals(vm: vmState, callee: int, argumentCount: int): unit {
    var slot = argumentCount
    while slot < vm.functionLocals[callee] {
        vmPush(vm, 0, 0)
        slot = slot + 1
    }
}

func vmSaveFrame(vm: vmState, functionIndex: int, base: int, floor: int, resume: int): unit {
    if vm.frames.len() == vm.depth - 1 {
        vm.frames.push(vmFrameRecord { functionIndex: functionIndex, base: base, floor: floor, resume: resume })
    } else {
        frameSave(vm.frames[vm.depth - 1], functionIndex, base, floor, resume)
    }
    vm.depth = vm.depth + 1
}

func vmRuntimeCall(vm: vmState, callId: int): unit {
    if callId == 6 {
        vmPush(vm, 1, Runtime.argumentCount() - vm.argumentBase)
        return
    }
    if callId == 4 {
        let textTag = vmTopTag(vm)
        let textHandle = vmPop(vm)
        let pathTag = vmTopTag(vm)
        let pathHandle = vmPop(vm)
        if vm.failed != 0 { return }
        if textTag != 3 || pathTag != 3 {
            vmFail(vm, 2, 57)
            return
        }
        if Runtime.writeText(vm.strings[pathHandle], vm.strings[textHandle]) { vmPush(vm, 2, 1) } else { vmPush(vm, 2, 0) }
        return
    }
    let argumentTag = vmTopTag(vm)
    let argumentValue = vmPop(vm)
    if vm.failed != 0 { return }
    if callId == 5 && argumentTag == 3 {
        vmPush(vm, 3, vmNewString(vm, Runtime.environment(vm.strings[argumentValue])))
        return
    }
    if callId == 7 && argumentTag == 1 {
        vmPush(vm, 3, vmNewString(vm, Runtime.argument(argumentValue + vm.argumentBase)))
        return
    }
    if callId == 2 && argumentTag == 3 {
        if Runtime.fileExists(vm.strings[argumentValue]) { vmPush(vm, 2, 1) } else { vmPush(vm, 2, 0) }
        return
    }
    if callId == 3 && argumentTag == 3 {
        let path = vm.strings[argumentValue]
        let bytes = read_bytes(path)
        vmPush(vm, 3, vmNewStringFrom(vm, Runtime.readText(path), bytes, 0, bytes.len()))
        return
    }
    vmFail(vm, 2, 57)
}

func vmHostBytes(vm: vmState, array: vmArray): int[] {
    if array.mixed == 0 { return array.values }
    var bytes: int[] = []
    var index = 0
    while index < arrayLen(array) && vm.failed == 0 {
        if arrayTag(array, index) != 1 {
            vmFail(vm, 2, 48)
        } else {
            bytes.push(arrayValue(array, index))
        }
        index = index + 1
    }
    return bytes
}

// READ_BYTES (47), WRITE_BYTES (48), ARRAY_LEN (49) e ARRAY_PUSH (50).
func vmArrayOp(vm: vmState, opcode: int): unit {
    if opcode == 50 {
        let elementTag = vmTopTag(vm)
        let elementValue = vmPop(vm)
        let targetTag = vmTopTag(vm)
        let targetHandle = vmPop(vm)
        if vm.failed != 0 { return }
        if targetTag != 4 {
            vmFail(vm, 2, opcode)
            return
        }
        arrayPush(vm.arrays[targetHandle], elementTag, elementValue)
        vmPush(vm, 1, arrayLen(vm.arrays[targetHandle]))
        return
    }
    if opcode == 49 {
        let targetTag = vmTopTag(vm)
        let targetHandle = vmPop(vm)
        if vm.failed != 0 { return }
        if targetTag != 4 {
            vmFail(vm, 2, opcode)
            return
        }
        vmPush(vm, 1, arrayLen(vm.arrays[targetHandle]))
        return
    }
    if opcode == 47 {
        let pathTag = vmTopTag(vm)
        let pathHandle = vmPop(vm)
        if vm.failed != 0 { return }
        if pathTag != 3 {
            vmFail(vm, 2, opcode)
            return
        }
        vmPush(vm, 4, vmBytesArray(vm, read_bytes(vm.strings[pathHandle])))
        return
    }
    let bytesTag = vmTopTag(vm)
    let bytesHandle = vmPop(vm)
    let pathTag = vmTopTag(vm)
    let pathHandle = vmPop(vm)
    if vm.failed != 0 { return }
    if bytesTag != 4 || pathTag != 3 {
        vmFail(vm, 2, opcode)
        return
    }
    let bytes = vmHostBytes(vm, vm.arrays[bytesHandle])
    if vm.failed != 0 { return }
    write_bytes(vm.strings[pathHandle], bytes)
    vmPush(vm, 0, 0)
}
