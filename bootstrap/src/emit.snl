package snova.compiler

func pushU32(code: int[], n: int): unit {
    var x = n
    var i = 0
    while i < 4 {
        code.push(x & 255)
        x = x >> 8
        i = i + 1
    }
}

func pushI64(code: int[], n: int): unit {
    var x = n
    var i = 0
    while i < 8 {
        code.push(x & 255)
        x = x >> 8
        i = i + 1
    }
}

func emitJump(code: int[], op: int): int {
    code.push(op)
    let at = code.len()
    pushU32(code, 0)
    return at
}

func patchAt(code: int[], fat: int[], fb: int[], at: int): unit {
    let off = code.len() - (at + 4)
    var x = off
    var i = 0
    while i < 4 {
        fat.push(at + i)
        fb.push(x & 255)
        x = x >> 8
        i = i + 1
    }
}

func byteAt(code: int[], fat: int[], fb: int[], i: int): int {
    var j = fat.len() - 1
    while j >= 0 {
        if fat[j] == i { return fb[j] }
        j = j - 1
    }
    return code[i]
}

func poolEq(bg: compilerState, idx: int, bytes: int[]): bool {
    if bg.pool_n[idx] != bytes.len() { return false }
    let s = bg.pool_s[idx]
    var j = 0
    while j < bytes.len() {
        if bg.pool_b[s + j] != bytes[j] { return false }
        j = j + 1
    }
    return true
}

func internBytes(bytes: int[], bg: compilerState): int {
    var i = 0
    while i < bg.pool_n.len() {
        if poolEq(bg, i, bytes) { return i }
        i = i + 1
    }
    let s = bg.pool_b.len()
    var j = 0
    while j < bytes.len() {
        bg.pool_b.push(bytes[j])
        j = j + 1
    }
    bg.pool_s.push(s)
    bg.pool_n.push(bytes.len())
    return bg.pool_n.len() - 1
}

func internSpan(src: int[], s: int, n: int, bg: compilerState): int {
    var tmp: int[] = []
    var j = 0
    while j < n {
        tmp.push(src[s + j])
        j = j + 1
    }
    return internBytes(tmp, bg)
}

func decodeString(src: int[], s: int, n: int, out: int[]): unit {
    if n < 2 { return }
    var i = s + 1
    let end = s + n - 1
    while i < end {
        let c = src[i]
        if c == 92 && i + 1 < end {
            let e = src[i + 1]
            var ch = e
            if e == 110 { ch = 10 }
            if e == 116 { ch = 9 }
            if e == 114 { ch = 13 }
            if e == 48 { ch = 0 }
            if e == 92 { ch = 92 }
            if e == 34 { ch = 34 }
            out.push(ch)
            i = i + 2
        } else {
            out.push(c)
            i = i + 1
        }
    }
}

func consCount(bg: compilerState, c: int): int {
    var n = 0
    var cur = c
    while cur >= 0 {
        n = n + 1
        cur = bg.nc[cur]
    }
    return n
}

func consFirst(bg: compilerState, c: int): int {
    var cur = c
    var item = -1
    while cur >= 0 {
        item = bg.nb[cur]
        cur = bg.nc[cur]
    }
    return item
}

func findLocal(src: int[], bg: compilerState, cx: compilerContext, s: int, n: int): int {
    var seen: int[] = []
    var i = bg.loc_slot.len() - 1
    while i >= cx.loc_base {
        let sl = bg.loc_slot[i]
        if sl < cx.locals && hasInt(seen, sl) {
        } else {
            if sl < cx.locals {
                if spanEq(src, bg.loc_ns[i], bg.loc_nl[i], s, n) {
                    return sl
                }
                seen.push(sl)
            }
        }
        i = i - 1
    }
    return -1
}

func localTypeOf(bg: compilerState, cx: compilerContext, slot: int): int {
    var i = bg.loc_slot.len() - 1
    while i >= cx.loc_base {
        if bg.loc_slot[i] == slot { return bg.loc_ty[i] }
        i = i - 1
    }
    return 0
}

func setLocalTy(bg: compilerState, cx: compilerContext, slot: int, ty: int): unit {
    var i = bg.loc_slot.len() - 1
    while i >= cx.loc_base {
        if bg.loc_slot[i] == slot {
            bg.loc_slot.push(slot)
            bg.loc_ns.push(bg.loc_ns[i])
            bg.loc_nl.push(bg.loc_nl[i])
            bg.loc_ty.push(ty)
            bg.loc_mut.push(bg.loc_mut[i])
            return
        }
        i = i - 1
    }
}

func localMutable(bg: compilerState, cx: compilerContext, slot: int): int {
    var i = bg.loc_slot.len() - 1
    while i >= cx.loc_base {
        if bg.loc_slot[i] == slot { return bg.loc_mut[i] }
        i = i - 1
    }
    return 1
}

func addLocal(bg: compilerState, cx: compilerContext, ns: int, nl: int, ty: int): int {
    return addLocalWith(bg, cx, ns, nl, ty, 1)
}

func addLocalWith(bg: compilerState, cx: compilerContext, ns: int, nl: int, ty: int, mutable: int): int {
    if cx.locals >= 256 {
        fail(cx)
        return 0
    }
    let slot = cx.locals
    cx.locals = cx.locals + 1
    if cx.locals > cx.water {
        cx.water = cx.locals
    }
    bg.loc_slot.push(slot)
    bg.loc_ns.push(ns)
    bg.loc_nl.push(nl)
    bg.loc_ty.push(ty)
    bg.loc_mut.push(mutable)
    return slot
}

func findFunc(src: int[], bg: compilerState, s: int, n: int): int {
    var i = 0
    while i < bg.fn_ns.len() {
        if bg.fn_own[i] < 0 {
            if spanEq(src, bg.fn_ns[i], bg.fn_nl[i], s, n) { return i }
        }
        i = i + 1
    }
    return -1
}

func fieldIndex(src: int[], bg: compilerState, st: int, ns: int, nl: int): int {
    var i = 0
    var idx = 0
    var found = -1
    while i < bg.fd_st.len() {
        if bg.fd_st[i] == st {
            if found < 0 && spanEq(src, bg.fd_ns[i], bg.fd_nl[i], ns, nl) {
                found = idx
            }
            idx = idx + 1
        }
        i = i + 1
    }
    return found
}

func fieldTypeAt(src: int[], bg: compilerState, st: int, ns: int, nl: int): int {
    var i = 0
    while i < bg.fd_st.len() {
        if bg.fd_st[i] == st && spanEq(src, bg.fd_ns[i], bg.fd_nl[i], ns, nl) {
            return bg.fd_ty[i]
        }
        i = i + 1
    }
    return 0
}

func emitForward(src: int[], bg: compilerState, cx: compilerContext, code: int[], fat: int[], fb: int[], c: int, as_stmt: int): unit {
    if cx.failed != 0 { return }
    if c < 0 { return }
    emitForward(src, bg, cx, code, fat, fb, bg.nc[c], as_stmt)
    if as_stmt == 1 {
        emitStmt(src, bg, cx, code, fat, fb, bg.nb[c])
    } else {
        emitExpr(src, bg, cx, code, fat, fb, bg.nb[c])
    }
}

func emitAnd(src: int[], bg: compilerState, cx: compilerContext, code: int[], fat: int[], fb: int[], lhs: int, rhs: int, start: int): unit {
    emitExpr(src, bg, cx, code, fat, fb, lhs)
    let leftType = cx.expr_ty
    let j1 = emitJump(code, 31)
    emitExpr(src, bg, cx, code, fat, fb, rhs)
    let rightType = cx.expr_ty
    if checkBinaryTypes(src, cx, 43, leftType, rightType, start) != 0 { return }
    let j2 = emitJump(code, 31)
    code.push(4)
    code.push(1)
    let j3 = emitJump(code, 30)
    patchAt(code, fat, fb, j1)
    patchAt(code, fat, fb, j2)
    code.push(4)
    code.push(0)
    patchAt(code, fat, fb, j3)
    cx.expr_ty = -2
}

func emitOr(src: int[], bg: compilerState, cx: compilerContext, code: int[], fat: int[], fb: int[], lhs: int, rhs: int, start: int): unit {
    emitExpr(src, bg, cx, code, fat, fb, lhs)
    let leftType = cx.expr_ty
    let j1 = emitJump(code, 32)
    emitExpr(src, bg, cx, code, fat, fb, rhs)
    let rightType = cx.expr_ty
    if checkBinaryTypes(src, cx, 44, leftType, rightType, start) != 0 { return }
    let j2 = emitJump(code, 32)
    code.push(4)
    code.push(0)
    let j3 = emitJump(code, 30)
    patchAt(code, fat, fb, j1)
    patchAt(code, fat, fb, j2)
    code.push(4)
    code.push(1)
    patchAt(code, fat, fb, j3)
    cx.expr_ty = -2
}

func binOp(op: int): int {
    if op == 34 { return 12 }
    if op == 35 { return 13 }
    if op == 36 { return 14 }
    if op == 37 { return 15 }
    if op == 38 { return 16 }
    if op == 39 { return 19 }
    if op == 40 { return 20 }
    if op == 41 { return 21 }
    if op == 45 { return 22 }
    if op == 46 { return 23 }
    if op == 28 { return 24 }
    if op == 29 { return 25 }
    if op == 30 { return 26 }
    if op == 31 { return 27 }
    if op == 32 { return 28 }
    if op == 33 { return 29 }
    return -1
}

func emitDefault(bg: compilerState, code: int[], ty: int): unit {
    if ty == -2 {
        code.push(4)
        code.push(0)
        return
    }
    if ty == -3 {
        var empty: int[] = []
        let si = internBytes(empty, bg)
        code.push(3)
        pushU32(code, si)
        return
    }
    code.push(1)
    pushI64(code, 0)
}

func fieldValue(src: int[], bg: compilerState, cons: int, ns: int, nl: int): int {
    var found = -1
    var c = cons
    while c >= 0 {
        let item = bg.nb[c]
        if item >= 0 && bg.nk[item] == 14 {
            if spanEq(src, bg.na[item], bg.nb[item], ns, nl) {
                found = bg.nc[item]
            }
        }
        c = bg.nc[c]
    }
    return found
}

func structFieldsKnown(src: int[], bg: compilerState, st: int, cons: int): bool {
    var c = cons
    var ok = 1
    while c >= 0 {
        let item = bg.nb[c]
        if item < 0 || bg.nk[item] != 14 {
            ok = 0
        } else {
            if fieldIndex(src, bg, st, bg.na[item], bg.nb[item]) < 0 {
                ok = 0
            }
        }
        c = bg.nc[c]
    }
    if ok == 1 { return true }
    return false
}

func namePrint(src: int[], s: int, n: int): int {
    if isWord(src, s, n, 9, 112, 114, 105, 110, 116, 108, 105, 110, 101, 0, 0, 0) { return 1 }
    if isWord(src, s, n, 7, 112, 114, 105, 110, 116, 108, 110, 0, 0, 0, 0, 0) { return 1 }
    if isWord(src, s, n, 5, 112, 114, 105, 110, 116, 0, 0, 0, 0, 0, 0, 0) { return 2 }
    return 0
}

func emitPrint(src: int[], bg: compilerState, cx: compilerContext, code: int[], fat: int[], fb: int[], args: int, which: int): unit {
    if consCount(bg, args) == 0 {
        var empty: int[] = []
        let si = internBytes(empty, bg)
        code.push(3)
        pushU32(code, si)
    } else {
        emitExpr(src, bg, cx, code, fat, fb, consFirst(bg, args))
    }
    code.push(45)
    if which == 2 {
        code.push(0)
    } else {
        code.push(1)
    }
    code.push(5)
    cx.expr_ty = 0
}

