package snova.compiler.runtime

import builtin.io.console

// Table of one-byte strings used to turn the SnBC pool (ASCII bytes) into
// host strings. The seed subset has no bytes -> string conversion.
func vmTextTable(table: string[]): unit {
    var index = 0
    while index < 32 {
        if index == 9 {
            table.push("\t")
        } else if index == 10 {
            table.push("\n")
        } else if index == 13 {
            table.push("\r")
        } else {
            table.push("")
        }
        index = index + 1
    }
    table.push(" ")
    table.push("!")
    table.push("\"")
    table.push("#")
    table.push("$")
    table.push("%")
    table.push("&")
    table.push("'")
    table.push("(")
    table.push(")")
    table.push("*")
    table.push("+")
    table.push(",")
    table.push("-")
    table.push(".")
    table.push("/")
    table.push("0")
    table.push("1")
    table.push("2")
    table.push("3")
    table.push("4")
    table.push("5")
    table.push("6")
    table.push("7")
    table.push("8")
    table.push("9")
    table.push(":")
    table.push(";")
    table.push("<")
    table.push("=")
    table.push(">")
    table.push("?")
    table.push("@")
    table.push("A")
    table.push("B")
    table.push("C")
    table.push("D")
    table.push("E")
    table.push("F")
    table.push("G")
    table.push("H")
    table.push("I")
    table.push("J")
    table.push("K")
    table.push("L")
    table.push("M")
    table.push("N")
    table.push("O")
    table.push("P")
    table.push("Q")
    table.push("R")
    table.push("S")
    table.push("T")
    table.push("U")
    table.push("V")
    table.push("W")
    table.push("X")
    table.push("Y")
    table.push("Z")
    table.push("[")
    table.push("\\")
    table.push("]")
    table.push("^")
    table.push("_")
    table.push("`")
    table.push("a")
    table.push("b")
    table.push("c")
    table.push("d")
    table.push("e")
    table.push("f")
    table.push("g")
    table.push("h")
    table.push("i")
    table.push("j")
    table.push("k")
    table.push("l")
    table.push("m")
    table.push("n")
    table.push("o")
    table.push("p")
    table.push("q")
    table.push("r")
    table.push("s")
    table.push("t")
    table.push("u")
    table.push("v")
    table.push("w")
    table.push("x")
    table.push("y")
    table.push("z")
    table.push("{")
    table.push("|")
    table.push("}")
    table.push("~")
}

func vmTextByte(byte: int): bool {
    if byte == 9 || byte == 10 || byte == 13 { return true }
    return byte >= 32 && byte <= 126
}

// Prints source bytes start..start+length (ASCII) for diagnostics.
public func printSourceSpan(source: int[], start: int, length: int): unit {
    var table: string[] = []
    vmTextTable(table)
    var text = ""
    var index = 0
    while index < length {
        let byte = source[start + index]
        if vmTextByte(byte) { text = text + table[byte] }
        index = index + 1
    }
    Console.print(text)
}
