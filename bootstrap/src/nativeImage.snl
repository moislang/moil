package snova.compiler.backend

// Read-only view of a validated SnBC image: header, string pool and
// function table (layout written by compiler.snl writeImage).
class NativeImage {
    public var bytes: int[]

    public method byteAt(offset: int): int {
        return bytes[offset]
    }

    public method u32(offset: int): int {
        return bytes[offset] + bytes[offset + 1] * 256 +
            bytes[offset + 2] * 65536 + bytes[offset + 3] * 16777216
    }

    public method signed32(offset: int): int {
        let value = u32(offset)
        if value >= 2147483648 { return value - 4294967296 }
        return value
    }

    public method mainFunction(): int {
        return u32(8)
    }

    public method poolCount(): int {
        return u32(12)
    }

    // Offset of the function table, after the string pool.
    public method functionTable(): int {
        var offset = 16
        var poolIndex = 0
        while poolIndex < poolCount() {
            offset = offset + 4 + u32(offset)
            poolIndex = poolIndex + 1
        }
        return offset
    }

    public method operandWidth(opcode: int): int {
        if opcode == 1 || opcode == 2 || opcode == 33 || opcode == 34 || opcode == 36 || opcode == 42 ||
            opcode == 53 || opcode == 54 || opcode == 55 || opcode == 57 { return 8 }
        if opcode == 3 || opcode == 8 || opcode == 9 || opcode == 10 || opcode == 11 ||
            opcode == 30 || opcode == 31 || opcode == 32 || opcode == 37 || opcode == 38 ||
            opcode == 39 || opcode == 43 || opcode == 44 { return 4 }
        if opcode == 4 || opcode == 45 { return 1 }
        return 0
    }
}
