package snova.compiler.backend

// Utilitários de texto do backend nativo. O subset do seed não converte
// literais em bytes, então o assembly é montado como strings do host e
// gravado com Runtime.writeText.
func nativeDigit(digit: int): string {
    if digit == 0 { return "0" }
    if digit == 1 { return "1" }
    if digit == 2 { return "2" }
    if digit == 3 { return "3" }
    if digit == 4 { return "4" }
    if digit == 5 { return "5" }
    if digit == 6 { return "6" }
    if digit == 7 { return "7" }
    if digit == 8 { return "8" }
    return "9"
}

// Decimal de um inteiro não negativo.
func nativeDecimal(value: int): string {
    if value < 10 { return nativeDigit(value) }
    return nativeDecimal(value / 10) + nativeDigit(value % 10)
}

// Une as linhas por divisão ao meio: O(n log n) cópias, em vez de O(n²).
func nativeJoinRange(lines: string[], start: int, end: int): string {
    if end - start == 1 { return lines[start] + "\n" }
    let middle = start + (end - start) / 2
    return nativeJoinRange(lines, start, middle) + nativeJoinRange(lines, middle, end)
}

func nativeJoin(lines: string[]): string {
    if lines.len() == 0 { return "" }
    return nativeJoinRange(lines, 0, lines.len())
}

func nativeU32(image: int[], offset: int): int {
    return image[offset] + image[offset + 1] * 256 +
        image[offset + 2] * 65536 + image[offset + 3] * 16777216
}

func nativeSigned32(value: int): int {
    if value >= 2147483648 { return value - 4294967296 }
    return value
}

func nativeOperandWidth(opcode: int): int {
    if opcode == 1 || opcode == 2 || opcode == 33 || opcode == 34 || opcode == 36 || opcode == 42 ||
        opcode == 53 || opcode == 54 || opcode == 55 || opcode == 57 { return 8 }
    if opcode == 3 || opcode == 8 || opcode == 9 || opcode == 10 || opcode == 11 ||
        opcode == 30 || opcode == 31 || opcode == 32 || opcode == 37 || opcode == 38 ||
        opcode == 39 || opcode == 43 || opcode == 44 { return 4 }
    if opcode == 4 || opcode == 45 { return 1 }
    return 0
}
