package mois.compiler.runtime

class ImageCursor {
    public var offset: int
    public var valid: int

    public method readU32(data: int[]): int {
        if valid == 0 { return 0 }
        if offset < 0 || offset > data.len() - 4 {
            valid = 0
            return 0
        }
        let start = offset
        let value = data[start] + data[start + 1] * 256 +
            data[start + 2] * 65536 + data[start + 3] * 16777216
        offset = start + 4
        return value
    }

    public method skip(data: int[], count: int): unit {
        if valid == 0 { return }
        if count < 0 || offset < 0 || count > data.len() - offset {
            valid = 0
            return
        }
        offset = offset + count
    }

    public method isValid(): int { return valid }
    public method position(): int { return offset }
}

public func validateImage(data: int[]): int {
    let cursor = ImageCursor(0, 1)
    if cursor.readU32(data) != 1128418899 { return 0 }
    if cursor.readU32(data) != 1 { return 0 }
    let mainIndex = cursor.readU32(data)
    let stringCount = cursor.readU32(data)
    if cursor.isValid() == 0 || stringCount > data.len() / 4 { return 0 }
    var index = 0
    while index < stringCount {
        let length = cursor.readU32(data)
        cursor.skip(data, length)
        if cursor.isValid() == 0 { return 0 }
        index = index + 1
    }
    let functionCount = cursor.readU32(data)
    if cursor.isValid() == 0 || functionCount == 0 || mainIndex >= functionCount { return 0 }
    var arities: int[] = []
    var locals: int[] = []
    var codeStarts: int[] = []
    var codeLengths: int[] = []
    index = 0
    while index < functionCount {
        let nameLength = cursor.readU32(data)
        cursor.skip(data, nameLength)
        let arity = cursor.readU32(data)
        let localCount = cursor.readU32(data)
        let codeLength = cursor.readU32(data)
        if cursor.isValid() == 0 || localCount < arity || localCount > 256 || codeLength == 0 { return 0 }
        arities.push(arity)
        locals.push(localCount)
        codeStarts.push(cursor.position())
        codeLengths.push(codeLength)
        cursor.skip(data, codeLength)
        if cursor.isValid() == 0 { return 0 }
        index = index + 1
    }
    if cursor.position() != data.len() { return 0 }
    if arities[mainIndex] != 0 { return 0 }
    index = 0
    while index < functionCount {
        if validateCode(data, codeStarts[index], codeLengths[index], stringCount, arities, locals[index]) == 0 { return 0 }
        index = index + 1
    }
    return 1
}
