package snova.tools.documentation

import builtin.io.console
import builtin.runtime

func literalBytes(value: string): int[] {
    if value == "[\n" { return [91, 10] }
    if value == "annotation,name,kind,signature,description\n" { return [97, 110, 110, 111, 116, 97, 116, 105, 111, 110, 44, 110, 97, 109, 101, 44, 107, 105, 110, 100, 44, 115, 105, 103, 110, 97, 116, 117, 114, 101, 44, 100, 101, 115, 99, 114, 105, 112, 116, 105, 111, 110, 10] }
    if value == ",\n" { return [44, 10] }
    if value == "  {\"annotation\":" { return [32, 32, 123, 34, 97, 110, 110, 111, 116, 97, 116, 105, 111, 110, 34, 58] }
    if value == ",\"name\":" { return [44, 34, 110, 97, 109, 101, 34, 58] }
    if value == ",\"kind\":" { return [44, 34, 107, 105, 110, 100, 34, 58] }
    if value == ",\"signature\":" { return [44, 34, 115, 105, 103, 110, 97, 116, 117, 114, 101, 34, 58] }
    if value == ",\"description\":" { return [44, 34, 100, 101, 115, 99, 114, 105, 112, 116, 105, 111, 110, 34, 58] }
    if value == "\n]\n" { return [10, 93, 10] }
    if value == "- annotation: " { return [45, 32, 97, 110, 110, 111, 116, 97, 116, 105, 111, 110, 58, 32] }
    if value == "\n  name: " { return [10, 32, 32, 110, 97, 109, 101, 58, 32] }
    if value == "\n  kind: " { return [10, 32, 32, 107, 105, 110, 100, 58, 32] }
    if value == "\n  signature: " { return [10, 32, 32, 115, 105, 103, 110, 97, 116, 117, 114, 101, 58, 32] }
    if value == "\n  description: " { return [10, 32, 32, 100, 101, 115, 99, 114, 105, 112, 116, 105, 111, 110, 58, 32] }
    return [0]
}

func appendLiteral(output: int[], value: string): unit {
    let bytes = literalBytes(value)
    var index = 0
    while index < bytes.len() && bytes[index] != 0 {
        output.push(bytes[index])
        index = index + 1
    }
}

func appendQuoted(output: int[], input: int[], start: int, end: int, format: int): unit {
    output.push(34)
    var index = start
    while index < end {
        let byte = input[index]
        if format == 1 && byte == 34 {
            output.push(34)
            output.push(34)
        } else if format != 1 && (byte == 34 || byte == 92) {
            output.push(92)
            output.push(byte)
        } else if format != 1 && byte == 10 {
            output.push(92)
            output.push(110)
        } else if format != 1 && byte == 13 {
            output.push(92)
            output.push(114)
        } else if format != 1 && byte == 9 {
            output.push(92)
            output.push(116)
        } else {
            output.push(byte)
        }
        index = index + 1
    }
    output.push(34)
}

func appendField(output: int[], input: int[], start: int, end: int, format: int): unit {
    appendQuoted(output, input, start, end, format)
}

func hasDocumentedAnnotation(input: int[], start: int, end: int): bool {
    if end - start != 13 { return false }
    let expected = [64, 68, 111, 99, 117, 109, 101, 110, 116, 101, 100, 40, 41]
    var index = 0
    while index < expected.len() {
        if input[start + index] != expected[index] { return false }
        index = index + 1
    }
    return true
}

func appendRecord(output: int[], input: int[], starts: int[], ends: int[], format: int, first: bool): unit {
    if format == 2 {
        if !first { appendLiteral(output, ",\n") }
        appendLiteral(output, "  {\"annotation\":")
        appendField(output, input, starts[0], ends[0], format)
        appendLiteral(output, ",\"name\":")
        appendField(output, input, starts[1], ends[1], format)
        appendLiteral(output, ",\"kind\":")
        appendField(output, input, starts[2], ends[2], format)
        appendLiteral(output, ",\"signature\":")
        appendField(output, input, starts[3], ends[3], format)
        appendLiteral(output, ",\"description\":")
        appendField(output, input, starts[4], ends[4], format)
        output.push(125)
    } else if format == 1 {
        if !first { output.push(10) }
        appendField(output, input, starts[0], ends[0], format)
        output.push(44)
        appendField(output, input, starts[1], ends[1], format)
        output.push(44)
        appendField(output, input, starts[2], ends[2], format)
        output.push(44)
        appendField(output, input, starts[3], ends[3], format)
        output.push(44)
        appendField(output, input, starts[4], ends[4], format)
    } else {
        if !first { output.push(10) }
        appendLiteral(output, "- annotation: ")
        appendField(output, input, starts[0], ends[0], format)
        appendLiteral(output, "\n  name: ")
        appendField(output, input, starts[1], ends[1], format)
        appendLiteral(output, "\n  kind: ")
        appendField(output, input, starts[2], ends[2], format)
        appendLiteral(output, "\n  signature: ")
        appendField(output, input, starts[3], ends[3], format)
        appendLiteral(output, "\n  description: ")
        appendField(output, input, starts[4], ends[4], format)
    }
}

func generate(input: int[], format: int): int[] {
    var output: int[] = []
    if format == 2 { appendLiteral(output, "[\n") }
    if format == 1 { appendLiteral(output, "annotation,name,kind,signature,description\n") }
    var lineStart = 0
    var first = true
    while lineStart < input.len() {
        var lineEnd = lineStart
        while lineEnd < input.len() && input[lineEnd] != 10 { lineEnd = lineEnd + 1 }
        var starts = [lineStart, 0, 0, 0, 0]
        var ends = [0, 0, 0, 0, lineEnd]
        var field = 0
        var cursor = lineStart
        while cursor < lineEnd {
            if input[cursor] == 9 && field < 4 {
                ends[field] = cursor
                field = field + 1
                starts[field] = cursor + 1
            }
            cursor = cursor + 1
        }
        if field == 4 && hasDocumentedAnnotation(input, starts[0], ends[0]) {
            appendRecord(output, input, starts, ends, format, first)
            first = false
        }
        lineStart = lineEnd + 1
    }
    if format == 2 { appendLiteral(output, "\n]\n") }
    if format != 2 { output.push(10) }
    return output
}

func main(): int {
    let inputPath = Runtime.environment("SNOVA_DOC_INPUT")
    let outputPath = Runtime.environment("SNOVA_DOC_OUTPUT")
    let requestedFormat = Runtime.environment("SNOVA_DOC_FORMAT")
    if inputPath == "" || outputPath == "" {
        Console.printline("set SNOVA_DOC_INPUT, SNOVA_DOC_OUTPUT and SNOVA_DOC_FORMAT")
        return 2
    }

    var format = 0
    if requestedFormat == "csv" { format = 1 }
    if requestedFormat == "json" { format = 2 }
    if requestedFormat != "yaml" && requestedFormat != "csv" && requestedFormat != "json" {
        Console.printline("supported documentation formats: yaml, csv, json")
        return 2
    }

    let input = read_bytes(inputPath)
    let output = generate(input, format)
    write_bytes(outputPath, output)
    return 0
}
